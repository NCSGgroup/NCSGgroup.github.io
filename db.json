ble":true},{"content":null,"created":"2017-11-13T12:12:12Z","format":null,"hash":null,"hash_algorithm":null,"last_modified":"2017-11-13T12:12:12Z","mimetype":null,"name":"ne_110m_coastline.shx","path":"data/cartopy_data/shapefiles/natural_earth/physical/ne_110m_coastline.shx","size":1172,"type":"file","writable":true},{"content":null,"created":"2017-08-12T08:07:40Z","format":null,"hash":null,"hash_algorithm":null,"last_modified":"2017-08-12T08:07:40Z","mimetype":null,"name":"ne_110m_coastline.cpg","path":"data/cartopy_data/shapefiles/natural_earth/physical/ne_110m_coastline.cpg","size":5,"type":"file","writable":true},{"content":null,"created":"2018-05-20T16:28:52Z","format":null,"hash":null,"hash_algorithm":null,"last_modified":"2018-05-20T16:28:52Z","mimetype":"text/html","name":"ne_110m_coastline.README.html","path":"data/cartopy_data/shapefiles/natural_earth/physical/ne_110m_coastline.README.html","size":22376,"type":"file","writable":true},{"content":null,"created":"2017-11-13T12:12:12Z","format":null,"hash":null,"hash_algorithm":null,"last_modified":"2017-11-13T12:12:12Z","mimetype":null,"name":"ne_110m_coastline.shp","path":"data/cartopy_data/shapefiles/natural_earth/physical/ne_110m_coastline.shp","size":89652,"type":"file","writable":true},{"content":null,"created":"2017-11-13T12:12:12Z","format":null,"hash":null,"hash_algorithm":null,"last_modified":"2017-11-13T12:12:12Z","mimetype":null,"name":"ne_110m_coastline.dbf","path":"data/cartopy_data/shapefiles/natural_earth/physical/ne_110m_coastline.dbf","size":3747,"type":"file","writable":true}],"created":"2026-08-07T05:56:33.752775Z","format":"json","hash":null,"hash_algorithm":null,"last_modified":"2026-08-07T05:56:33.756186Z","mimetype":null,"name":"physical","path":"data/cartopy_data/shapefiles/natural_earth/physical","size":null,"type":"directory","writable":true}},{"_id":"shapefiles/natural_earth/all","data":{"content":[{"content":null,"created":"2026-08-07T05:56:33.752775Z","format":null,"hash":null,"hash_algorithm":null,"last_modified":"2026-08-07T05:56:33.756186Z","mimetype":null,"name":"physical","path":"data/cartopy_data/shapefiles/natural_earth/physical","size":null,"type":"directory","writable":true}],"created":"2026-08-07T05:56:33.752745Z","format":"json","hash":null,"hash_algorithm":null,"last_modified":"2026-08-07T05:56:33.752775Z","mimetype":null,"name":"natural_earth","path":"data/cartopy_data/shapefiles/natural_earth","size":null,"type":"directory","writable":true}}],"Page":[{"title":"Welcome to NCSG group for numerical computation and satellite gravity! We here provide useful software for satellite gravity computation.","math":true,"_content":"\n<link\n  rel=\"stylesheet\"\n  href=\"https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css\"\n/>\n\nThe NCSG Group focuses on numerical computation, satellite gravity, geodesy, and Earth system mass transport. We develop computational methods and satellite gravity techniques to investigate mass redistribution in the Earth system.\n\n[<i class=\"fa-solid fa-code\"></i> <u>Software</u>](/software/) | [<i class=\"fa-solid fa-users\"></i> <u>Developers</u>](/developers/) | [<i class=\"fa-solid fa-book\"></i> <u>Publications</u>](/publications/)\n\n---\n\n## Software\n\n{% include_md _meta/_software.overview.md %}\n\n---\n## Contact us\n\nPlease leave your question, suggestion and comment on any of our published toolbox in [<u>our discussion forum</u>](https://github.com/orgs/NCSGgroup/discussions), so that we can answer or reach out to you as soon as possible.\n","source":"index.md","raw":"---\ntitle: Welcome to NCSG group for numerical computation and satellite gravity! We here provide useful software for satellite gravity computation.\nmath: true\n---\n\n<link\n  rel=\"stylesheet\"\n  href=\"https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css\"\n/>\n\nThe NCSG Group focuses on numerical computation, satellite gravity, geodesy, and Earth system mass transport. We develop computational methods and satellite gravity techniques to investigate mass redistribution in the Earth system.\n\n[<i class=\"fa-solid fa-code\"></i> <u>Software</u>](/software/) | [<i class=\"fa-solid fa-users\"></i> <u>Developers</u>](/developers/) | [<i class=\"fa-solid fa-book\"></i> <u>Publications</u>](/publications/)\n\n---\n\n## Software\n\n{% include_md _meta/_software.overview.md %}\n\n---\n## Contact us\n\nPlease leave your question, suggestion and comment on any of our published toolbox in [<u>our discussion forum</u>](https://github.com/orgs/NCSGgroup/discussions), so that we can answer or reach out to you as soon as possible.\n","date":"2026-08-07T02:39:56.006Z","updated":"2026-08-07T02:39:56.006Z","path":"index.html","comments":1,"layout":"page","_id":"cuidFvXoXtHPci9BHsYDn1TM7","content":"<link\n  rel=\"stylesheet\"\n  href=\"https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css\"\n/>\n<p>The NCSG Group focuses on numerical computation, satellite gravity, geodesy, and Earth system mass transport. We develop computational methods and satellite gravity techniques to investigate mass redistribution in the Earth system.</p>\n<p><a href=\"/software/\"><i class=\"fa-solid fa-code\"></i> <u>Software</u></a> | <a href=\"/developers/\"><i class=\"fa-solid fa-users\"></i> <u>Developers</u></a> | <a href=\"/publications/\"><i class=\"fa-solid fa-book\"></i> <u>Publications</u></a></p>\n<hr>\n<h2 id=\"Software\">Software</h2>\n<div class=\"ncsg-project-grid ncsg-project-grid--list\">\n  <a class=\"ncsg-project-card\" href=\"https://github.com/NCSGgroup/PyHawk\">\n    <div class=\"ncsg-project-card-header\">\n      <h3>PyHawk</h3>\n      <img src=\"../img/projects/logo_pyhawk.webp\" alt=\"Satellite gravity project\">\n    </div>\n    <div class=\"ncsg-project-card-body\">\n      <p>\n        An efficient gravity recovery solver for low-low satellite-to-satellite tracking gravity missions.\n      </p>\n    </div>\n  </a>\n  <a class=\"ncsg-project-card\" href=\"/software/sagea/\">\n    <div class=\"ncsg-project-card-header\">\n      <h3>SaGEA</h3>\n      <img src=\"../img/projects/logo_sagea.webp\" alt=\"GRACE data processing project\">\n    </div>\n    <div class=\"ncsg-project-card-body\">\n      <p>\n        SaGEA is a Python toolbox for post-processing and error assessment of satellite gravity products.\n      </p>\n    </div>\n  </a>\n  <a class=\"ncsg-project-card\" href=\"https://github.com/NCSGgroup/SaGEA-fluid\">\n    <div class=\"ncsg-project-card-header\">\n      <h3>SaGEA-Fluid</h3>\n      <img src=\"../img/projects/logo_sagea_fluid.webp\" alt=\"Numerical computation project\">\n    </div>\n    <div class=\"ncsg-project-card-body\">\n      <p>\n        SAGEA-fluid extends SaGEA to include self-attraction and loading effects, geocenter motion, and Earth rotation effects.\n      </p>\n    </div>\n  </a>\n  <a class=\"ncsg-project-card\" href=\"https://github.com/NCSGgroup/PyGLDA\">\n    <div class=\"ncsg-project-card-header\">\n      <h3>PyGLDA</h3>\n      <img src=\"../img/projects/logo_pyglda.webp\" alt=\"Interactive visualization project\">\n    </div>\n    <div class=\"ncsg-project-card-body\">\n      <p>\n        PyGLDA is a Python platform for assimilating GRACE into hydrological model. \n      </p>\n    </div>\n  </a>\n</div>\n<hr>\n<h2 id=\"Contact-us\">Contact us</h2>\n<p>Please leave your question, suggestion and comment on any of our published toolbox in <a href=\"https://github.com/orgs/NCSGgroup/discussions\"><u>our discussion forum</u></a>, so that we can answer or reach out to you as soon as possible.</p>\n","excerpt":"","more":"<link\n  rel=\"stylesheet\"\n  href=\"https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css\"\n/>\n<p>The NCSG Group focuses on numerical computation, satellite gravity, geodesy, and Earth system mass transport. We develop computational methods and satellite gravity techniques to investigate mass redistribution in the Earth system.</p>\n<p><a href=\"/software/\"><i class=\"fa-solid fa-code\"></i> <u>Software</u></a> | <a href=\"/developers/\"><i class=\"fa-solid fa-users\"></i> <u>Developers</u></a> | <a href=\"/publications/\"><i class=\"fa-solid fa-book\"></i> <u>Publications</u></a></p>\n<hr>\n<h2 id=\"Software\">Software</h2>\n<div class=\"ncsg-project-grid ncsg-project-grid--list\">\n  <a class=\"ncsg-project-card\" href=\"https://github.com/NCSGgroup/PyHawk\">\n    <div class=\"ncsg-project-card-header\">\n      <h3>PyHawk</h3>\n      <img src=\"../img/projects/logo_pyhawk.webp\" alt=\"Satellite gravity project\">\n    </div>\n    <div class=\"ncsg-project-card-body\">\n      <p>\n        An efficient gravity recovery solver for low-low satellite-to-satellite tracking gravity missions.\n      </p>\n    </div>\n  </a>\n  <a class=\"ncsg-project-card\" href=\"/software/sagea/\">\n    <div class=\"ncsg-project-card-header\">\n      <h3>SaGEA</h3>\n      <img src=\"../img/projects/logo_sagea.webp\" alt=\"GRACE data processing project\">\n    </div>\n    <div class=\"ncsg-project-card-body\">\n      <p>\n        SaGEA is a Python toolbox for post-processing and error assessment of satellite gravity products.\n      </p>\n    </div>\n  </a>\n  <a class=\"ncsg-project-card\" href=\"https://github.com/NCSGgroup/SaGEA-fluid\">\n    <div class=\"ncsg-project-card-header\">\n      <h3>SaGEA-Fluid</h3>\n      <img src=\"../img/projects/logo_sagea_fluid.webp\" alt=\"Numerical computation project\">\n    </div>\n    <div class=\"ncsg-project-card-body\">\n      <p>\n        SAGEA-fluid extends SaGEA to include self-attraction and loading effects, geocenter motion, and Earth rotation effects.\n      </p>\n    </div>\n  </a>\n  <a class=\"ncsg-project-card\" href=\"https://github.com/NCSGgroup/PyGLDA\">\n    <div class=\"ncsg-project-card-header\">\n      <h3>PyGLDA</h3>\n      <img src=\"../img/projects/logo_pyglda.webp\" alt=\"Interactive visualization project\">\n    </div>\n    <div class=\"ncsg-project-card-body\">\n      <p>\n        PyGLDA is a Python platform for assimilating GRACE into hydrological model. \n      </p>\n    </div>\n  </a>\n</div>\n<hr>\n<h2 id=\"Contact-us\">Contact us</h2>\n<p>Please leave your question, suggestion and comment on any of our published toolbox in <a href=\"https://github.com/orgs/NCSGgroup/discussions\"><u>our discussion forum</u></a>, so that we can answer or reach out to you as soon as possible.</p>\n"},{"title":"Contact with us","_content":"\n# Contact\n\n## NCSG Group\n\nNumerical Computation and Satellite Gravity\n\nDepartment / School / University\n\n## Email\n\nGeneral contact: [ncsg@example.com](mailto:ncsg@example.com)\n\n## Links\n\n- [GitHub](https://github.com/NCSRgroup)\n\n## Join Us\n\nPlease leave your question, suggestion and comment on any of our published toolbox in [<u>our discussion forum<u>](https://github.com/orgs/NCSGgroup/discussions), so that we can answer or reach out to you as soon as possible.","source":"contact/index.md","raw":"---\ntitle: Contact with us\n---\n\n# Contact\n\n## NCSG Group\n\nNumerical Computation and Satellite Gravity\n\nDepartment / School / University\n\n## Email\n\nGeneral contact: [ncsg@example.com](mailto:ncsg@example.com)\n\n## Links\n\n- [GitHub](https://github.com/NCSRgroup)\n\n## Join Us\n\nPlease leave your question, suggestion and comment on any of our published toolbox in [<u>our discussion forum<u>](https://github.com/orgs/NCSGgroup/discussions), so that we can answer or reach out to you as soon as possible.","date":"2026-07-30T02:18:50.941Z","updated":"2026-07-30T02:18:50.941Z","path":"contact/index.html","comments":1,"layout":"page","_id":"cuidmHl05yZU132U9hP2gxRwv","content":"<h1 id=\"contact\">Contact</h1>\n<h2 id=\"NCSG-Group\">NCSG Group</h2>\n<p>Numerical Computation and Satellite Gravity</p>\n<p>Department / School / University</p>\n<h2 id=\"Email\">Email</h2>\n<p>General contact: <a href=\"mailto:ncsg@example.com\">ncsg@example.com</a></p>\n<h2 id=\"Links\">Links</h2>\n<ul>\n<li><a href=\"https://github.com/NCSRgroup\">GitHub</a></li>\n</ul>\n<h2 id=\"Join-Us\">Join Us</h2>\n<p>Please leave your question, suggestion and comment on any of our published toolbox in <a href=\"https://github.com/orgs/NCSGgroup/discussions\"><u>our discussion forum<u></a>, so that we can answer or reach out to you as soon as possible.</p>\n","excerpt":"","more":"<h1>Contact</h1>\n<h2 id=\"NCSG-Group\">NCSG Group</h2>\n<p>Numerical Computation and Satellite Gravity</p>\n<p>Department / School / University</p>\n<h2 id=\"Email\">Email</h2>\n<p>General contact: <a href=\"mailto:ncsg@example.com\">ncsg@example.com</a></p>\n<h2 id=\"Links\">Links</h2>\n<ul>\n<li><a href=\"https://github.com/NCSRgroup\">GitHub</a></li>\n</ul>\n<h2 id=\"Join-Us\">Join Us</h2>\n<p>Please leave your question, suggestion and comment on any of our published toolbox in <a href=\"https://github.com/orgs/NCSGgroup/discussions\"><u>our discussion forum<u></a>, so that we can answer or reach out to you as soon as possible.</p>\n"},{"_content":"/* =========================================================\n * NCSG Projects merged styles\n *\n * 合并自：\n * - ncsg-projects.css\n * - ncsg-projects-extra.css\n *\n * 功能：\n * 1. 双列卡片布局\n * 2. 单列长条布局 .ncsg-project-grid--list\n * 3. 浅色 / 深色主题适配\n * 4. 自适应 SVG 图标颜色\n * 5. 图片尺寸变量控制\n * 6. 修复窄容器下单列布局显示异常的问题\n * ========================================================= */\n\n\n/* =========================================================\n * 1. Theme variables\n * 默认浅色模式\n * ========================================================= */\n\n:root {\n  /* ---------- 卡片颜色 ---------- */\n  --ncsg-project-card-bg: #ffffff;\n  --ncsg-project-card-bg-soft: #f8fafc;\n  --ncsg-project-card-text: #263244;\n  --ncsg-project-card-muted: #5f6b7a;\n  --ncsg-project-card-border: rgba(80, 100, 120, 0.24);\n  --ncsg-project-card-border-hover: #2d9cdb;\n  --ncsg-project-card-shadow-hover: 0 10px 28px rgba(20, 35, 55, 0.14);\n\n  --ncsg-project-logo-bg: #f3f6fa;\n\n  /* ---------- 链接按钮 ---------- */\n  --ncsg-project-link-bg: rgba(45, 156, 219, 0.10);\n  --ncsg-project-link-bg-hover: #2d9cdb;\n  --ncsg-project-link-text: #1f7fb4;\n  --ncsg-project-link-text-hover: #ffffff;\n\n  /* ---------- 自适应 SVG 图标 ---------- */\n  --ncsg-adaptive-icon-fill: #263244;\n  --ncsg-adaptive-icon-fill-hover: #1f7fb4;\n\n  /* ---------- 双列卡片图片尺寸 ---------- */\n  --ncsg-project-double-img-width: 30%;\n  --ncsg-project-double-img-max-width: 150px;\n  --ncsg-project-double-img-height: 160px;\n\n  /* ---------- 单列长条布局尺寸 ---------- */\n  --ncsg-project-list-media-width: 220px;\n  --ncsg-project-list-card-min-height: 170px;\n  --ncsg-project-list-img-size: 200px;\n\n  /* ---------- 窄屏 / 窄容器图片尺寸 ---------- */\n  --ncsg-project-mobile-img-width: 70%;\n  --ncsg-project-mobile-img-max-width: 210px;\n  --ncsg-project-mobile-img-height: 120px;\n\n  /* ---------- 单列布局变为上下结构的容器宽度 ---------- */\n  --ncsg-project-list-stack-breakpoint: 680px;\n}\n\n\n/* =========================================================\n * 2. 系统深色模式兜底\n * ========================================================= */\n\n@media (prefers-color-scheme: dark) {\n  :root {\n    --ncsg-project-card-bg: rgba(30, 39, 50, 0.96);\n    --ncsg-project-card-bg-soft: rgba(33, 43, 55, 0.98);\n    --ncsg-project-card-text: #e8edf3;\n    --ncsg-project-card-muted: #d7dee8;\n    --ncsg-project-card-border: rgba(120, 140, 160, 0.45);\n    --ncsg-project-card-border-hover: #4db6e2;\n    --ncsg-project-card-shadow-hover: 0 10px 28px rgba(0, 0, 0, 0.28);\n\n    --ncsg-project-logo-bg: rgba(15, 23, 32, 0.36);\n\n    --ncsg-project-link-bg: rgba(77, 182, 226, 0.14);\n    --ncsg-project-link-bg-hover: #4db6e2;\n    --ncsg-project-link-text: #8bd4f2;\n    --ncsg-project-link-text-hover: #0d1b24;\n\n    --ncsg-adaptive-icon-fill: #e8edf3;\n    --ncsg-adaptive-icon-fill-hover: #8bd4f2;\n  }\n}\n\n\n/* =========================================================\n * 3. Fluid / Hexo 显式深色模式\n * ========================================================= */\n\nhtml[data-user-color-scheme=\"dark\"],\nbody[data-user-color-scheme=\"dark\"],\n[data-user-color-scheme=\"dark\"],\nhtml.dark,\nbody.dark {\n  --ncsg-project-card-bg: rgba(30, 39, 50, 0.96);\n  --ncsg-project-card-bg-soft: rgba(33, 43, 55, 0.98);\n  --ncsg-project-card-text: #e8edf3;\n  --ncsg-project-card-muted: #d7dee8;\n  --ncsg-project-card-border: rgba(120, 140, 160, 0.45);\n  --ncsg-project-card-border-hover: #4db6e2;\n  --ncsg-project-card-shadow-hover: 0 10px 28px rgba(0, 0, 0, 0.28);\n\n  --ncsg-project-logo-bg: rgba(15, 23, 32, 0.36);\n\n  --ncsg-project-link-bg: rgba(77, 182, 226, 0.14);\n  --ncsg-project-link-bg-hover: #4db6e2;\n  --ncsg-project-link-text: #8bd4f2;\n  --ncsg-project-link-text-hover: #0d1b24;\n\n  --ncsg-adaptive-icon-fill: #e8edf3;\n  --ncsg-adaptive-icon-fill-hover: #8bd4f2;\n}\n\n\n/* =========================================================\n * 4. Fluid / Hexo 显式浅色模式\n * 放在深色模式之后，确保手动切换 light 时可以覆盖系统 dark\n * ========================================================= */\n\nhtml[data-user-color-scheme=\"light\"],\nbody[data-user-color-scheme=\"light\"],\n[data-user-color-scheme=\"light\"],\nhtml.light,\nbody.light {\n  --ncsg-project-card-bg: #ffffff;\n  --ncsg-project-card-bg-soft: #f8fafc;\n  --ncsg-project-card-text: #263244;\n  --ncsg-project-card-muted: #5f6b7a;\n  --ncsg-project-card-border: rgba(80, 100, 120, 0.24);\n  --ncsg-project-card-border-hover: #2d9cdb;\n  --ncsg-project-card-shadow-hover: 0 10px 28px rgba(20, 35, 55, 0.14);\n\n  --ncsg-project-logo-bg: #f3f6fa;\n\n  --ncsg-project-link-bg: rgba(45, 156, 219, 0.10);\n  --ncsg-project-link-bg-hover: #2d9cdb;\n  --ncsg-project-link-text: #1f7fb4;\n  --ncsg-project-link-text-hover: #ffffff;\n\n  --ncsg-adaptive-icon-fill: #263244;\n  --ncsg-adaptive-icon-fill-hover: #1f7fb4;\n}\n\n\n/* =========================================================\n * 5. 基础项目网格\n * 默认：双列卡片布局\n * ========================================================= */\n\n.ncsg-project-grid {\n  display: grid;\n  grid-template-columns: repeat(2, minmax(0, 1fr));\n  gap: 6px;\n  margin-top: 1.8rem;\n  margin-bottom: 2rem;\n\n  /*\n   * 关键修复之一：\n   * 启用 container query。\n   * 这样即使浏览器视口没有小于 768px，\n   * 只要内容区域本身变窄，单列长条也能自动变成上下结构。\n   */\n  container-type: inline-size;\n}\n\n.ncsg-project-card,\n.ncsg-project-card * {\n  box-sizing: border-box;\n}\n\n\n/* =========================================================\n * 6. 基础卡片样式\n * ========================================================= */\n\n.ncsg-project-card {\n  display: flex;\n  flex-direction: column;\n\n  min-height: 340px;\n\n  border: 1px solid var(--ncsg-project-card-border);\n  border-radius: 4px;\n  overflow: hidden;\n\n  text-decoration: none !important;\n  color: var(--ncsg-project-card-text) !important;\n  background: var(--ncsg-project-card-bg);\n\n  transition:\n    transform 0.18s ease,\n    box-shadow 0.18s ease,\n    border-color 0.18s ease;\n}\n\n.ncsg-project-card:hover {\n  transform: translateY(-3px);\n  border-color: var(--ncsg-project-card-border-hover);\n  box-shadow: var(--ncsg-project-card-shadow-hover);\n  text-decoration: none !important;\n}\n\n.ncsg-project-card-header {\n  padding: 1.2rem 1.2rem 1rem;\n\n  text-align: center;\n\n  background: var(--ncsg-project-card-bg);\n  border-bottom: 1px solid var(--ncsg-project-card-border);\n}\n\n.ncsg-project-card-header h3 {\n  margin: 0 0 1rem;\n\n  font-size: 1.05rem;\n  font-weight: 700;\n  line-height: 1.35;\n\n  color: var(--ncsg-project-card-text);\n}\n\n.ncsg-project-card-header img,\n.ncsg-project-card-header svg.icon,\n.ncsg-project-card-header svg.ncsg-adaptive-icon {\n  display: block;\n\n  width: 62%;\n  max-width: 220px;\n  height: 150px;\n\n  object-fit: contain;\n\n  margin: 0 auto;\n\n  opacity: 0.92;\n}\n\n.ncsg-project-card-body {\n  flex: 1;\n\n  padding: 1rem 1.3rem 1.2rem;\n\n  text-align: center;\n\n  background: var(--ncsg-project-card-bg-soft);\n}\n\n.ncsg-project-card-body p {\n  margin: 0;\n\n  line-height: 1.65;\n  font-size: 0.95rem;\n\n  color: var(--ncsg-project-card-muted);\n}\n\n\n/* =========================================================\n * 7. 双列布局中的图片 / SVG 尺寸控制\n * 只作用于普通双列布局，不影响单列长条布局\n * ========================================================= */\n\n.ncsg-project-grid:not(.ncsg-project-grid--list)\n  .ncsg-project-card-header img,\n.ncsg-project-grid:not(.ncsg-project-grid--list)\n  .ncsg-project-card-header svg.icon,\n.ncsg-project-grid:not(.ncsg-project-grid--list)\n  .ncsg-project-card-header svg.ncsg-adaptive-icon {\n  display: block;\n\n  width: var(--ncsg-project-double-img-width);\n  max-width: var(--ncsg-project-double-img-max-width);\n  height: var(--ncsg-project-double-img-height);\n\n  margin: 1rem auto;\n\n  object-fit: contain;\n}\n\n\n/* =========================================================\n * 8. 单列长条布局\n *\n * 使用方式：\n *\n * <div class=\"ncsg-project-grid ncsg-project-grid--list\">\n *   ...\n * </div>\n *\n * 桌面宽屏时：\n * 左侧图片，右侧标题和简介。\n * ========================================================= */\n\n.ncsg-project-grid.ncsg-project-grid--list {\n  grid-template-columns: 1fr;\n  gap: 1rem;\n}\n\n.ncsg-project-grid--list .ncsg-project-card {\n  display: grid;\n  grid-template-columns: var(--ncsg-project-list-media-width) minmax(0, 1fr);\n  grid-template-rows: auto 1fr;\n\n  min-height: var(--ncsg-project-list-card-min-height);\n\n  border-radius: 10px;\n  overflow: hidden;\n}\n\n\n/* 左侧图片区背景 */\n.ncsg-project-grid--list .ncsg-project-card::before {\n  content: \"\";\n\n  grid-column: 1;\n  grid-row: 1 / span 2;\n\n  background: var(--ncsg-project-logo-bg);\n  border-right: 1px solid var(--ncsg-project-card-border);\n\n  z-index: 0;\n}\n\n\n/*\n * 兼容原 HTML 结构：\n *\n * .ncsg-project-card\n *   .ncsg-project-card-header\n *     h3\n *     img\n *   .ncsg-project-card-body\n *     p\n *\n * 宽屏下使用 display: contents，\n * 让 h3 和 img 直接参与 card 的 grid 布局。\n */\n.ncsg-project-grid--list .ncsg-project-card-header {\n  display: contents;\n\n  padding: 0;\n  border-bottom: none;\n  text-align: left;\n}\n\n\n/* 单列长条：左侧图片 / SVG */\n.ncsg-project-grid--list .ncsg-project-card-header img,\n.ncsg-project-grid--list .ncsg-project-card-header svg.icon,\n.ncsg-project-grid--list .ncsg-project-card-header svg.ncsg-adaptive-icon {\n  grid-column: 1;\n  grid-row: 1 / span 2;\n\n  align-self: center;\n  justify-self: center;\n\n  width: var(--ncsg-project-list-img-size);\n  max-width: calc(var(--ncsg-project-list-media-width) - 2rem);\n  height: var(--ncsg-project-list-img-size);\n  min-height: 0;\n\n  padding: 0;\n  margin: 0;\n\n  object-fit: contain;\n\n  background: transparent;\n  border-right: none;\n\n  opacity: 0.96;\n\n  z-index: 1;\n}\n\n\n/* 单列长条：右侧标题 */\n.ncsg-project-grid--list .ncsg-project-card-header h3 {\n  grid-column: 2;\n  grid-row: 1;\n\n  margin: 0;\n  padding: 1.25rem 1.5rem 0.35rem;\n\n  font-size: 1.2rem;\n  font-weight: 700;\n  line-height: 1.35;\n\n  text-align: left;\n\n  color: var(--ncsg-project-card-text);\n\n  z-index: 1;\n}\n\n\n/* 单列长条：右侧简介 */\n.ncsg-project-grid--list .ncsg-project-card-body {\n  grid-column: 2;\n  grid-row: 2;\n\n  min-width: 0;\n\n  padding: 0.25rem 1.5rem 1.25rem;\n\n  text-align: left;\n  background: var(--ncsg-project-card-bg);\n\n  z-index: 1;\n}\n\n.ncsg-project-grid--list .ncsg-project-card-body p {\n  margin: 0;\n  max-width: 760px;\n\n  font-size: 0.98rem;\n  line-height: 1.7;\n\n  color: var(--ncsg-project-card-muted);\n}\n\n\n/* =========================================================\n * 9. Links 按钮样式\n *\n * 如果在 body 中添加：\n *\n * <div class=\"ncsg-project-card-links\">\n *   <a href=\"...\">GitHub</a>\n *   <a href=\"...\">Docs</a>\n * </div>\n *\n * 会自动显示为按钮。\n * ========================================================= */\n\n.ncsg-project-card-links {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 0.5rem;\n\n  margin-top: 1rem;\n}\n\n.ncsg-project-card-links a {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n\n  padding: 0.34rem 0.75rem;\n  border-radius: 999px;\n\n  font-size: 0.85rem;\n  font-weight: 600;\n  line-height: 1.4;\n\n  color: var(--ncsg-project-link-text) !important;\n  background: var(--ncsg-project-link-bg);\n  border: 1px solid rgba(45, 156, 219, 0.28);\n\n  text-decoration: none !important;\n\n  transition:\n    color 0.16s ease,\n    background-color 0.16s ease,\n    border-color 0.16s ease,\n    transform 0.16s ease;\n}\n\n.ncsg-project-card-links a:hover {\n  color: var(--ncsg-project-link-text-hover) !important;\n  background: var(--ncsg-project-link-bg-hover);\n  border-color: var(--ncsg-project-link-bg-hover);\n\n  transform: translateY(-1px);\n  text-decoration: none !important;\n}\n\n\n/* =========================================================\n * 10. 自适应 SVG 图标\n * ========================================================= */\n\n.ncsg-adaptive-icon {\n  transition:\n    fill 0.18s ease,\n    opacity 0.18s ease,\n    transform 0.18s ease;\n}\n\n/* 覆盖 SVG 内部写死的 fill */\n.ncsg-adaptive-icon path:not([fill=\"none\"]),\n.ncsg-adaptive-icon circle:not([fill=\"none\"]),\n.ncsg-adaptive-icon rect:not([fill=\"none\"]),\n.ncsg-adaptive-icon polygon:not([fill=\"none\"]),\n.ncsg-adaptive-icon polyline:not([fill=\"none\"]),\n.ncsg-adaptive-icon ellipse:not([fill=\"none\"]) {\n  fill: var(--ncsg-adaptive-icon-fill) !important;\n  transition: fill 0.18s ease;\n}\n\n/* 兼容 stroke 描边图标 */\n.ncsg-adaptive-icon path[stroke]:not([stroke=\"none\"]),\n.ncsg-adaptive-icon line[stroke]:not([stroke=\"none\"]),\n.ncsg-adaptive-icon circle[stroke]:not([stroke=\"none\"]),\n.ncsg-adaptive-icon rect[stroke]:not([stroke=\"none\"]),\n.ncsg-adaptive-icon polyline[stroke]:not([stroke=\"none\"]),\n.ncsg-adaptive-icon polygon[stroke]:not([stroke=\"none\"]) {\n  stroke: var(--ncsg-adaptive-icon-fill) !important;\n  transition: stroke 0.18s ease;\n}\n\n/* 卡片 hover 时图标变强调色 */\n.ncsg-project-card:hover .ncsg-adaptive-icon path:not([fill=\"none\"]),\n.ncsg-project-card:hover .ncsg-adaptive-icon circle:not([fill=\"none\"]),\n.ncsg-project-card:hover .ncsg-adaptive-icon rect:not([fill=\"none\"]),\n.ncsg-project-card:hover .ncsg-adaptive-icon polygon:not([fill=\"none\"]),\n.ncsg-project-card:hover .ncsg-adaptive-icon polyline:not([fill=\"none\"]),\n.ncsg-project-card:hover .ncsg-adaptive-icon ellipse:not([fill=\"none\"]) {\n  fill: var(--ncsg-adaptive-icon-fill-hover) !important;\n}\n\n.ncsg-project-card:hover .ncsg-adaptive-icon path[stroke]:not([stroke=\"none\"]),\n.ncsg-project-card:hover .ncsg-adaptive-icon line[stroke]:not([stroke=\"none\"]),\n.ncsg-project-card:hover .ncsg-adaptive-icon circle[stroke]:not([stroke=\"none\"]),\n.ncsg-project-card:hover .ncsg-adaptive-icon rect[stroke]:not([stroke=\"none\"]),\n.ncsg-project-card:hover .ncsg-adaptive-icon polyline[stroke]:not([stroke=\"none\"]),\n.ncsg-project-card:hover .ncsg-adaptive-icon polygon[stroke]:not([stroke=\"none\"]) {\n  stroke: var(--ncsg-adaptive-icon-fill-hover) !important;\n}\n\n\n/* =========================================================\n * 11. 普通双列布局的移动端响应\n * 非 .ncsg-project-grid--list 时使用\n * ========================================================= */\n\n@media (max-width: 768px) {\n  .ncsg-project-grid:not(.ncsg-project-grid--list) {\n    grid-template-columns: 1fr;\n  }\n\n  .ncsg-project-grid:not(.ncsg-project-grid--list) .ncsg-project-card {\n    min-height: auto;\n  }\n\n  .ncsg-project-grid:not(.ncsg-project-grid--list)\n    .ncsg-project-card-header img,\n  .ncsg-project-grid:not(.ncsg-project-grid--list)\n    .ncsg-project-card-header svg.icon,\n  .ncsg-project-grid:not(.ncsg-project-grid--list)\n    .ncsg-project-card-header svg.ncsg-adaptive-icon {\n    width: 55%;\n    height: 130px;\n  }\n}\n\n\n/* =========================================================\n * 12. 单列长条布局在窄容器下自动变为：\n *\n * 标题\n * 图片\n * 简介\n *\n * 这是修复你截图中 bug 的关键部分。\n *\n * 使用 container query，而不是只依赖浏览器 viewport。\n * ========================================================= */\n\n@container (max-width: 680px) {\n  .ncsg-project-grid--list .ncsg-project-card {\n    display: grid;\n    grid-template-columns: 1fr;\n    grid-template-rows: auto auto;\n\n    min-height: auto;\n  }\n\n  .ncsg-project-grid--list .ncsg-project-card::before {\n    display: none;\n  }\n\n  .ncsg-project-grid--list .ncsg-project-card-header {\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n\n    grid-column: 1;\n    grid-row: 1;\n\n    padding: 1.1rem 2.5rem 0.9rem;\n\n    text-align: center;\n\n    background: var(--ncsg-project-logo-bg);\n    border-bottom: 1px solid var(--ncsg-project-card-border);\n  }\n\n  .ncsg-project-grid--list .ncsg-project-card-header h3 {\n    order: 1;\n\n    grid-column: auto;\n    grid-row: auto;\n\n    margin: 0 0 0.75rem;\n    padding: 0;\n\n    font-size: 1.1rem;\n    line-height: 1.35;\n    text-align: center;\n  }\n\n  .ncsg-project-grid--list .ncsg-project-card-header img,\n  .ncsg-project-grid--list .ncsg-project-card-header svg.icon,\n  .ncsg-project-grid--list .ncsg-project-card-header svg.ncsg-adaptive-icon {\n    order: 2;\n\n    grid-column: auto;\n    grid-row: auto;\n\n    align-self: center;\n    justify-self: center;\n\n    width: var(--ncsg-project-mobile-img-width);\n    max-width: var(--ncsg-project-mobile-img-max-width);\n    height: var(--ncsg-project-mobile-img-height);\n    min-height: 0;\n\n    margin: 0 auto;\n    padding: 0;\n\n    object-fit: contain;\n\n    background: transparent;\n    border-right: none;\n  }\n\n  .ncsg-project-grid--list .ncsg-project-card-body {\n    grid-column: 1;\n    grid-row: 2;\n\n    padding: 1rem 2.5rem 1.25rem;\n\n    text-align: center;\n\n    background: var(--ncsg-project-card-bg);\n  }\n\n  .ncsg-project-grid--list .ncsg-project-card-body p {\n    max-width: none;\n\n    font-size: 0.95rem;\n    line-height: 1.7;\n  }\n\n  .ncsg-project-grid--list .ncsg-project-card-links {\n    justify-content: center;\n  }\n}\n\n\n/* =========================================================\n * 13. 兼容不支持 container query 的浏览器\n * 当视口过窄时，也强制切换为上下结构\n * ========================================================= */\n\n@media (max-width: 768px) {\n  .ncsg-project-grid.ncsg-project-grid--list {\n    gap: 1rem;\n  }\n\n  .ncsg-project-grid--list .ncsg-project-card {\n    display: grid;\n    grid-template-columns: 1fr;\n    grid-template-rows: auto auto;\n\n    min-height: auto;\n  }\n\n  .ncsg-project-grid--list .ncsg-project-card::before {\n    display: none;\n  }\n\n  .ncsg-project-grid--list .ncsg-project-card-header {\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n\n    grid-column: 1;\n    grid-row: 1;\n\n    padding: 1.1rem 1.2rem 0.9rem;\n\n    text-align: center;\n\n    background: var(--ncsg-project-logo-bg);\n    border-bottom: 1px solid var(--ncsg-project-card-border);\n  }\n\n  .ncsg-project-grid--list .ncsg-project-card-header h3 {\n    order: 1;\n\n    grid-column: auto;\n    grid-row: auto;\n\n    margin: 0 0 0.75rem;\n    padding: 0;\n\n    font-size: 1.1rem;\n    line-height: 1.35;\n    text-align: center;\n  }\n\n  .ncsg-project-grid--list .ncsg-project-card-header img,\n  .ncsg-project-grid--list .ncsg-project-card-header svg.icon,\n  .ncsg-project-grid--list .ncsg-project-card-header svg.ncsg-adaptive-icon {\n    order: 2;\n\n    grid-column: auto;\n    grid-row: auto;\n\n    align-self: center;\n    justify-self: center;\n\n    width: var(--ncsg-project-mobile-img-width);\n    max-width: var(--ncsg-project-mobile-img-max-width);\n    height: var(--ncsg-project-mobile-img-height);\n    min-height: 0;\n\n    margin: 0 auto;\n    padding: 0;\n\n    object-fit: contain;\n\n    background: transparent;\n    border-right: none;\n  }\n\n  .ncsg-project-grid--list .ncsg-project-card-body {\n    grid-column: 1;\n    grid-row: 2;\n\n    padding: 1rem 1.2rem 1.25rem;\n\n    text-align: center;\n\n    background: var(--ncsg-project-card-bg);\n  }\n\n  .ncsg-project-grid--list .ncsg-project-card-body p {\n    max-width: none;\n\n    font-size: 0.95rem;\n    line-height: 1.7;\n  }\n\n  .ncsg-project-grid--list .ncsg-project-card-links {\n    justify-content: center;\n  }\n}","source":"css/ncsg-projects.css","raw":"/* =========================================================\n * NCSG Projects merged styles\n *\n * 合并自：\n * - ncsg-projects.css\n * - ncsg-projects-extra.css\n *\n * 功能：\n * 1. 双列卡片布局\n * 2. 单列长条布局 .ncsg-project-grid--list\n * 3. 浅色 / 深色主题适配\n * 4. 自适应 SVG 图标颜色\n * 5. 图片尺寸变量控制\n * 6. 修复窄容器下单列布局显示异常的问题\n * ========================================================= */\n\n\n/* =========================================================\n * 1. Theme variables\n * 默认浅色模式\n * ========================================================= */\n\n:root {\n  /* ---------- 卡片颜色 ---------- */\n  --ncsg-project-card-bg: #ffffff;\n  --ncsg-project-card-bg-soft: #f8fafc;\n  --ncsg-project-card-text: #263244;\n  --ncsg-project-card-muted: #5f6b7a;\n  --ncsg-project-card-border: rgba(80, 100, 120, 0.24);\n  --ncsg-project-card-border-hover: #2d9cdb;\n  --ncsg-project-card-shadow-hover: 0 10px 28px rgba(20, 35, 55, 0.14);\n\n  --ncsg-project-logo-bg: #f3f6fa;\n\n  /* ---------- 链接按钮 ---------- */\n  --ncsg-project-link-bg: rgba(45, 156, 219, 0.10);\n  --ncsg-project-link-bg-hover: #2d9cdb;\n  --ncsg-project-link-text: #1f7fb4;\n  --ncsg-project-link-text-hover: #ffffff;\n\n  /* ---------- 自适应 SVG 图标 ---------- */\n  --ncsg-adaptive-icon-fill: #263244;\n  --ncsg-adaptive-icon-fill-hover: #1f7fb4;\n\n  /* ---------- 双列卡片图片尺寸 ---------- */\n  --ncsg-project-double-img-width: 30%;\n  --ncsg-project-double-img-max-width: 150px;\n  --ncsg-project-double-img-height: 160px;\n\n  /* ---------- 单列长条布局尺寸 ---------- */\n  --ncsg-project-list-media-width: 220px;\n  --ncsg-project-list-card-min-height: 170px;\n  --ncsg-project-list-img-size: 200px;\n\n  /* ---------- 窄屏 / 窄容器图片尺寸 ---------- */\n  --ncsg-project-mobile-img-width: 70%;\n  --ncsg-project-mobile-img-max-width: 210px;\n  --ncsg-project-mobile-img-height: 120px;\n\n  /* ---------- 单列布局变为上下结构的容器宽度 ---------- */\n  --ncsg-project-list-stack-breakpoint: 680px;\n}\n\n\n/* =========================================================\n * 2. 系统深色模式兜底\n * ========================================================= */\n\n@media (prefers-color-scheme: dark) {\n  :root {\n    --ncsg-project-card-bg: rgba(30, 39, 50, 0.96);\n    --ncsg-project-card-bg-soft: rgba(33, 43, 55, 0.98);\n    --ncsg-project-card-text: #e8edf3;\n    --ncsg-project-card-muted: #d7dee8;\n    --ncsg-project-card-border: rgba(120, 140, 160, 0.45);\n    --ncsg-project-card-border-hover: #4db6e2;\n    --ncsg-project-card-shadow-hover: 0 10px 28px rgba(0, 0, 0, 0.28);\n\n    --ncsg-project-logo-bg: rgba(15, 23, 32, 0.36);\n\n    --ncsg-project-link-bg: rgba(77, 182, 226, 0.14);\n    --ncsg-project-link-bg-hover: #4db6e2;\n    --ncsg-project-link-text: #8bd4f2;\n    --ncsg-project-link-text-hover: #0d1b24;\n\n    --ncsg-adaptive-icon-fill: #e8edf3;\n    --ncsg-adaptive-icon-fill-hover: #8bd4f2;\n  }\n}\n\n\n/* =========================================================\n * 3. Fluid / Hexo 显式深色模式\n * ========================================================= */\n\nhtml[data-user-color-scheme=\"dark\"],\nbody[data-user-color-scheme=\"dark\"],\n[data-user-color-scheme=\"dark\"],\nhtml.dark,\nbody.dark {\n  --ncsg-project-card-bg: rgba(30, 39, 50, 0.96);\n  --ncsg-project-card-bg-soft: rgba(33, 43, 55, 0.98);\n  --ncsg-project-card-text: #e8edf3;\n  --ncsg-project-card-muted: #d7dee8;\n  --ncsg-project-card-border: rgba(120, 140, 160, 0.45);\n  --ncsg-project-card-border-hover: #4db6e2;\n  --ncsg-project-card-shadow-hover: 0 10px 28px rgba(0, 0, 0, 0.28);\n\n  --ncsg-project-logo-bg: rgba(15, 23, 32, 0.36);\n\n  --ncsg-project-link-bg: rgba(77, 182, 226, 0.14);\n  --ncsg-project-link-bg-hover: #4db6e2;\n  --ncsg-project-link-text: #8bd4f2;\n  --ncsg-project-link-text-hover: #0d1b24;\n\n  --ncsg-adaptive-icon-fill: #e8edf3;\n  --ncsg-adaptive-icon-fill-hover: #8bd4f2;\n}\n\n\n/* =========================================================\n * 4. Fluid / Hexo 显式浅色模式\n * 放在深色模式之后，确保手动切换 light 时可以覆盖系统 dark\n * ========================================================= */\n\nhtml[data-user-color-scheme=\"light\"],\nbody[data-user-color-scheme=\"light\"],\n[data-user-color-scheme=\"light\"],\nhtml.light,\nbody.light {\n  --ncsg-project-card-bg: #ffffff;\n  --ncsg-project-card-bg-soft: #f8fafc;\n  --ncsg-project-card-text: #263244;\n  --ncsg-project-card-muted: #5f6b7a;\n  --ncsg-project-card-border: rgba(80, 100, 120, 0.24);\n  --ncsg-project-card-border-hover: #2d9cdb;\n  --ncsg-project-card-shadow-hover: 0 10px 28px rgba(20, 35, 55, 0.14);\n\n  --ncsg-project-logo-bg: #f3f6fa;\n\n  --ncsg-project-link-bg: rgba(45, 156, 219, 0.10);\n  --ncsg-project-link-bg-hover: #2d9cdb;\n  --ncsg-project-link-text: #1f7fb4;\n  --ncsg-project-link-text-hover: #ffffff;\n\n  --ncsg-adaptive-icon-fill: #263244;\n  --ncsg-adaptive-icon-fill-hover: #1f7fb4;\n}\n\n\n/* =========================================================\n * 5. 基础项目网格\n * 默认：双列卡片布局\n * ========================================================= */\n\n.ncsg-project-grid {\n  display: grid;\n  grid-template-columns: repeat(2, minmax(0, 1fr));\n  gap: 6px;\n  margin-top: 1.8rem;\n  margin-bottom: 2rem;\n\n  /*\n   * 关键修复之一：\n   * 启用 container query。\n   * 这样即使浏览器视口没有小于 768px，\n   * 只要内容区域本身变窄，单列长条也能自动变成上下结构。\n   */\n  container-type: inline-size;\n}\n\n.ncsg-project-card,\n.ncsg-project-card * {\n  box-sizing: border-box;\n}\n\n\n/* =========================================================\n * 6. 基础卡片样式\n * ========================================================= */\n\n.ncsg-project-card {\n  display: flex;\n  flex-direction: column;\n\n  min-height: 340px;\n\n  border: 1px solid var(--ncsg-project-card-border);\n  border-radius: 4px;\n  overflow: hidden;\n\n  text-decoration: none !important;\n  color: var(--ncsg-project-card-text) !important;\n  background: var(--ncsg-project-card-bg);\n\n  transition:\n    transform 0.18s ease,\n    box-shadow 0.18s ease,\n    border-color 0.18s ease;\n}\n\n.ncsg-project-card:hover {\n  transform: translateY(-3px);\n  border-color: var(--ncsg-project-card-border-hover);\n  box-shadow: var(--ncsg-project-card-shadow-hover);\n  text-decoration: none !important;\n}\n\n.ncsg-project-card-header {\n  padding: 1.2rem 1.2rem 1rem;\n\n  text-align: center;\n\n  background: var(--ncsg-project-card-bg);\n  border-bottom: 1px solid var(--ncsg-project-card-border);\n}\n\n.ncsg-project-card-header h3 {\n  margin: 0 0 1rem;\n\n  font-size: 1.05rem;\n  font-weight: 700;\n  line-height: 1.35;\n\n  color: var(--ncsg-project-card-text);\n}\n\n.ncsg-project-card-header img,\n.ncsg-project-card-header svg.icon,\n.ncsg-project-card-header svg.ncsg-adaptive-icon {\n  display: block;\n\n  width: 62%;\n  max-width: 220px;\n  height: 150px;\n\n  object-fit: contain;\n\n  margin: 0 auto;\n\n  opacity: 0.92;\n}\n\n.ncsg-project-card-body {\n  flex: 1;\n\n  padding: 1rem 1.3rem 1.2rem;\n\n  text-align: center;\n\n  background: var(--ncsg-project-card-bg-soft);\n}\n\n.ncsg-project-card-body p {\n  margin: 0;\n\n  line-height: 1.65;\n  font-size: 0.95rem;\n\n  color: var(--ncsg-project-card-muted);\n}\n\n\n/* =========================================================\n * 7. 双列布局中的图片 / SVG 尺寸控制\n * 只作用于普通双列布局，不影响单列长条布局\n * ========================================================= */\n\n.ncsg-project-grid:not(.ncsg-project-grid--list)\n  .ncsg-project-card-header img,\n.ncsg-project-grid:not(.ncsg-project-grid--list)\n  .ncsg-project-card-header svg.icon,\n.ncsg-project-grid:not(.ncsg-project-grid--list)\n  .ncsg-project-card-header svg.ncsg-adaptive-icon {\n  display: block;\n\n  width: var(--ncsg-project-double-img-width);\n  max-width: var(--ncsg-project-double-img-max-width);\n  height: var(--ncsg-project-double-img-height);\n\n  margin: 1rem auto;\n\n  object-fit: contain;\n}\n\n\n/* =========================================================\n * 8. 单列长条布局\n *\n * 使用方式：\n *\n * <div class=\"ncsg-project-grid ncsg-project-grid--list\">\n *   ...\n * </div>\n *\n * 桌面宽屏时：\n * 左侧图片，右侧标题和简介。\n * ========================================================= */\n\n.ncsg-project-grid.ncsg-project-grid--list {\n  grid-template-columns: 1fr;\n  gap: 1rem;\n}\n\n.ncsg-project-grid--list .ncsg-project-card {\n  display: grid;\n  grid-template-columns: var(--ncsg-project-list-media-width) minmax(0, 1fr);\n  grid-template-rows: auto 1fr;\n\n  min-height: var(--ncsg-project-list-card-min-height);\n\n  border-radius: 10px;\n  overflow: hidden;\n}\n\n\n/* 左侧图片区背景 */\n.ncsg-project-grid--list .ncsg-project-card::before {\n  content: \"\";\n\n  grid-column: 1;\n  grid-row: 1 / span 2;\n\n  background: var(--ncsg-project-logo-bg);\n  border-right: 1px solid var(--ncsg-project-card-border);\n\n  z-index: 0;\n}\n\n\n/*\n * 兼容原 HTML 结构：\n *\n * .ncsg-project-card\n *   .ncsg-project-card-header\n *     h3\n *     img\n *   .ncsg-project-card-body\n *     p\n *\n * 宽屏下使用 display: contents，\n * 让 h3 和 img 直接参与 card 的 grid 布局。\n */\n.ncsg-project-grid--list .ncsg-project-card-header {\n  display: contents;\n\n  padding: 0;\n  border-bottom: none;\n  text-align: left;\n}\n\n\n/* 单列长条：左侧图片 / SVG */\n.ncsg-project-grid--list .ncsg-project-card-header img,\n.ncsg-project-grid--list .ncsg-project-card-header svg.icon,\n.ncsg-project-grid--list .ncsg-project-card-header svg.ncsg-adaptive-icon {\n  grid-column: 1;\n  grid-row: 1 / span 2;\n\n  align-self: center;\n  justify-self: center;\n\n  width: var(--ncsg-project-list-img-size);\n  max-width: calc(var(--ncsg-project-list-media-width) - 2rem);\n  height: var(--ncsg-project-list-img-size);\n  min-height: 0;\n\n  padding: 0;\n  margin: 0;\n\n  object-fit: contain;\n\n  background: transparent;\n  border-right: none;\n\n  opacity: 0.96;\n\n  z-index: 1;\n}\n\n\n/* 单列长条：右侧标题 */\n.ncsg-project-grid--list .ncsg-project-card-header h3 {\n  grid-column: 2;\n  grid-row: 1;\n\n  margin: 0;\n  padding: 1.25rem 1.5rem 0.35rem;\n\n  font-size: 1.2rem;\n  font-weight: 700;\n  line-height: 1.35;\n\n  text-align: left;\n\n  color: var(--ncsg-project-card-text);\n\n  z-index: 1;\n}\n\n\n/* 单列长条：右侧简介 */\n.ncsg-project-grid--list .ncsg-project-card-body {\n  grid-column: 2;\n  grid-row: 2;\n\n  min-width: 0;\n\n  padding: 0.25rem 1.5rem 1.25rem;\n\n  text-align: left;\n  background: var(--ncsg-project-card-bg);\n\n  z-index: 1;\n}\n\n.ncsg-project-grid--list .ncsg-project-card-body p {\n  margin: 0;\n  max-width: 760px;\n\n  font-size: 0.98rem;\n  line-height: 1.7;\n\n  color: var(--ncsg-project-card-muted);\n}\n\n\n/* =========================================================\n * 9. Links 按钮样式\n *\n * 如果在 body 中添加：\n *\n * <div class=\"ncsg-project-card-links\">\n *   <a href=\"...\">GitHub</a>\n *   <a href=\"...\">Docs</a>\n * </div>\n *\n * 会自动显示为按钮。\n * ========================================================= */\n\n.ncsg-project-card-links {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 0.5rem;\n\n  margin-top: 1rem;\n}\n\n.ncsg-project-card-links a {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n\n  padding: 0.34rem 0.75rem;\n  border-radius: 999px;\n\n  font-size: 0.85rem;\n  font-weight: 600;\n  line-height: 1.4;\n\n  color: var(--ncsg-project-link-text) !important;\n  background: var(--ncsg-project-link-bg);\n  border: 1px solid rgba(45, 156, 219, 0.28);\n\n  text-decoration: none !important;\n\n  transition:\n    color 0.16s ease,\n    background-color 0.16s ease,\n    border-color 0.16s ease,\n    transform 0.16s ease;\n}\n\n.ncsg-project-card-links a:hover {\n  color: var(--ncsg-project-link-text-hover) !important;\n  background: var(--ncsg-project-link-bg-hover);\n  border-color: var(--ncsg-project-link-bg-hover);\n\n  transform: translateY(-1px);\n  text-decoration: none !important;\n}\n\n\n/* =========================================================\n * 10. 自适应 SVG 图标\n * ========================================================= */\n\n.ncsg-adaptive-icon {\n  transition:\n    fill 0.18s ease,\n    opacity 0.18s ease,\n    transform 0.18s ease;\n}\n\n/* 覆盖 SVG 内部写死的 fill */\n.ncsg-adaptive-icon path:not([fill=\"none\"]),\n.ncsg-adaptive-icon circle:not([fill=\"none\"]),\n.ncsg-adaptive-icon rect:not([fill=\"none\"]),\n.ncsg-adaptive-icon polygon:not([fill=\"none\"]),\n.ncsg-adaptive-icon polyline:not([fill=\"none\"]),\n.ncsg-adaptive-icon ellipse:not([fill=\"none\"]) {\n  fill: var(--ncsg-adaptive-icon-fill) !important;\n  transition: fill 0.18s ease;\n}\n\n/* 兼容 stroke 描边图标 */\n.ncsg-adaptive-icon path[stroke]:not([stroke=\"none\"]),\n.ncsg-adaptive-icon line[stroke]:not([stroke=\"none\"]),\n.ncsg-adaptive-icon circle[stroke]:not([stroke=\"none\"]),\n.ncsg-adaptive-icon rect[stroke]:not([stroke=\"none\"]),\n.ncsg-adaptive-icon polyline[stroke]:not([stroke=\"none\"]),\n.ncsg-adaptive-icon polygon[stroke]:not([stroke=\"none\"]) {\n  stroke: var(--ncsg-adaptive-icon-fill) !important;\n  transition: stroke 0.18s ease;\n}\n\n/* 卡片 hover 时图标变强调色 */\n.ncsg-project-card:hover .ncsg-adaptive-icon path:not([fill=\"none\"]),\n.ncsg-project-card:hover .ncsg-adaptive-icon circle:not([fill=\"none\"]),\n.ncsg-project-card:hover .ncsg-adaptive-icon rect:not([fill=\"none\"]),\n.ncsg-project-card:hover .ncsg-adaptive-icon polygon:not([fill=\"none\"]),\n.ncsg-project-card:hover .ncsg-adaptive-icon polyline:not([fill=\"none\"]),\n.ncsg-project-card:hover .ncsg-adaptive-icon ellipse:not([fill=\"none\"]) {\n  fill: var(--ncsg-adaptive-icon-fill-hover) !important;\n}\n\n.ncsg-project-card:hover .ncsg-adaptive-icon path[stroke]:not([stroke=\"none\"]),\n.ncsg-project-card:hover .ncsg-adaptive-icon line[stroke]:not([stroke=\"none\"]),\n.ncsg-project-card:hover .ncsg-adaptive-icon circle[stroke]:not([stroke=\"none\"]),\n.ncsg-project-card:hover .ncsg-adaptive-icon rect[stroke]:not([stroke=\"none\"]),\n.ncsg-project-card:hover .ncsg-adaptive-icon polyline[stroke]:not([stroke=\"none\"]),\n.ncsg-project-card:hover .ncsg-adaptive-icon polygon[stroke]:not([stroke=\"none\"]) {\n  stroke: var(--ncsg-adaptive-icon-fill-hover) !important;\n}\n\n\n/* =========================================================\n * 11. 普通双列布局的移动端响应\n * 非 .ncsg-project-grid--list 时使用\n * ========================================================= */\n\n@media (max-width: 768px) {\n  .ncsg-project-grid:not(.ncsg-project-grid--list) {\n    grid-template-columns: 1fr;\n  }\n\n  .ncsg-project-grid:not(.ncsg-project-grid--list) .ncsg-project-card {\n    min-height: auto;\n  }\n\n  .ncsg-project-grid:not(.ncsg-project-grid--list)\n    .ncsg-project-card-header img,\n  .ncsg-project-grid:not(.ncsg-project-grid--list)\n    .ncsg-project-card-header svg.icon,\n  .ncsg-project-grid:not(.ncsg-project-grid--list)\n    .ncsg-project-card-header svg.ncsg-adaptive-icon {\n    width: 55%;\n    height: 130px;\n  }\n}\n\n\n/* =========================================================\n * 12. 单列长条布局在窄容器下自动变为：\n *\n * 标题\n * 图片\n * 简介\n *\n * 这是修复你截图中 bug 的关键部分。\n *\n * 使用 container query，而不是只依赖浏览器 viewport。\n * ========================================================= */\n\n@container (max-width: 680px) {\n  .ncsg-project-grid--list .ncsg-project-card {\n    display: grid;\n    grid-template-columns: 1fr;\n    grid-template-rows: auto auto;\n\n    min-height: auto;\n  }\n\n  .ncsg-project-grid--list .ncsg-project-card::before {\n    display: none;\n  }\n\n  .ncsg-project-grid--list .ncsg-project-card-header {\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n\n    grid-column: 1;\n    grid-row: 1;\n\n    padding: 1.1rem 2.5rem 0.9rem;\n\n    text-align: center;\n\n    background: var(--ncsg-project-logo-bg);\n    border-bottom: 1px solid var(--ncsg-project-card-border);\n  }\n\n  .ncsg-project-grid--list .ncsg-project-card-header h3 {\n    order: 1;\n\n    grid-column: auto;\n    grid-row: auto;\n\n    margin: 0 0 0.75rem;\n    padding: 0;\n\n    font-size: 1.1rem;\n    line-height: 1.35;\n    text-align: center;\n  }\n\n  .ncsg-project-grid--list .ncsg-project-card-header img,\n  .ncsg-project-grid--list .ncsg-project-card-header svg.icon,\n  .ncsg-project-grid--list .ncsg-project-card-header svg.ncsg-adaptive-icon {\n    order: 2;\n\n    grid-column: auto;\n    grid-row: auto;\n\n    align-self: center;\n    justify-self: center;\n\n    width: var(--ncsg-project-mobile-img-width);\n    max-width: var(--ncsg-project-mobile-img-max-width);\n    height: var(--ncsg-project-mobile-img-height);\n    min-height: 0;\n\n    margin: 0 auto;\n    padding: 0;\n\n    object-fit: contain;\n\n    background: transparent;\n    border-right: none;\n  }\n\n  .ncsg-project-grid--list .ncsg-project-card-body {\n    grid-column: 1;\n    grid-row: 2;\n\n    padding: 1rem 2.5rem 1.25rem;\n\n    text-align: center;\n\n    background: var(--ncsg-project-card-bg);\n  }\n\n  .ncsg-project-grid--list .ncsg-project-card-body p {\n    max-width: none;\n\n    font-size: 0.95rem;\n    line-height: 1.7;\n  }\n\n  .ncsg-project-grid--list .ncsg-project-card-links {\n    justify-content: center;\n  }\n}\n\n\n/* =========================================================\n * 13. 兼容不支持 container query 的浏览器\n * 当视口过窄时，也强制切换为上下结构\n * ========================================================= */\n\n@media (max-width: 768px) {\n  .ncsg-project-grid.ncsg-project-grid--list {\n    gap: 1rem;\n  }\n\n  .ncsg-project-grid--list .ncsg-project-card {\n    display: grid;\n    grid-template-columns: 1fr;\n    grid-template-rows: auto auto;\n\n    min-height: auto;\n  }\n\n  .ncsg-project-grid--list .ncsg-project-card::before {\n    display: none;\n  }\n\n  .ncsg-project-grid--list .ncsg-project-card-header {\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n\n    grid-column: 1;\n    grid-row: 1;\n\n    padding: 1.1rem 1.2rem 0.9rem;\n\n    text-align: center;\n\n    background: var(--ncsg-project-logo-bg);\n    border-bottom: 1px solid var(--ncsg-project-card-border);\n  }\n\n  .ncsg-project-grid--list .ncsg-project-card-header h3 {\n    order: 1;\n\n    grid-column: auto;\n    grid-row: auto;\n\n    margin: 0 0 0.75rem;\n    padding: 0;\n\n    font-size: 1.1rem;\n    line-height: 1.35;\n    text-align: center;\n  }\n\n  .ncsg-project-grid--list .ncsg-project-card-header img,\n  .ncsg-project-grid--list .ncsg-project-card-header svg.icon,\n  .ncsg-project-grid--list .ncsg-project-card-header svg.ncsg-adaptive-icon {\n    order: 2;\n\n    grid-column: auto;\n    grid-row: auto;\n\n    align-self: center;\n    justify-self: center;\n\n    width: var(--ncsg-project-mobile-img-width);\n    max-width: var(--ncsg-project-mobile-img-max-width);\n    height: var(--ncsg-project-mobile-img-height);\n    min-height: 0;\n\n    margin: 0 auto;\n    padding: 0;\n\n    object-fit: contain;\n\n    background: transparent;\n    border-right: none;\n  }\n\n  .ncsg-project-grid--list .ncsg-project-card-body {\n    grid-column: 1;\n    grid-row: 2;\n\n    padding: 1rem 1.2rem 1.25rem;\n\n    text-align: center;\n\n    background: var(--ncsg-project-card-bg);\n  }\n\n  .ncsg-project-grid--list .ncsg-project-card-body p {\n    max-width: none;\n\n    font-size: 0.95rem;\n    line-height: 1.7;\n  }\n\n  .ncsg-project-grid--list .ncsg-project-card-links {\n    justify-content: center;\n  }\n}","date":"2026-07-31T01:01:29.902Z","updated":"2026-07-31T01:01:29.902Z","path":"css/ncsg-projects.css","layout":"false","title":"","comments":1,"_id":"cuidl2dK_6NfLhuyuX6WYYj-V","content":"/* =========================================================\n * NCSG Projects merged styles\n *\n * 合并自：\n * - ncsg-projects.css\n * - ncsg-projects-extra.css\n *\n * 功能：\n * 1. 双列卡片布局\n * 2. 单列长条布局 .ncsg-project-grid--list\n * 3. 浅色 / 深色主题适配\n * 4. 自适应 SVG 图标颜色\n * 5. 图片尺寸变量控制\n * 6. 修复窄容器下单列布局显示异常的问题\n * ========================================================= */\n\n\n/* =========================================================\n * 1. Theme variables\n * 默认浅色模式\n * ========================================================= */\n\n:root {\n  /* ---------- 卡片颜色 ---------- */\n  --ncsg-project-card-bg: #ffffff;\n  --ncsg-project-card-bg-soft: #f8fafc;\n  --ncsg-project-card-text: #263244;\n  --ncsg-project-card-muted: #5f6b7a;\n  --ncsg-project-card-border: rgba(80, 100, 120, 0.24);\n  --ncsg-project-card-border-hover: #2d9cdb;\n  --ncsg-project-card-shadow-hover: 0 10px 28px rgba(20, 35, 55, 0.14);\n\n  --ncsg-project-logo-bg: #f3f6fa;\n\n  /* ---------- 链接按钮 ---------- */\n  --ncsg-project-link-bg: rgba(45, 156, 219, 0.10);\n  --ncsg-project-link-bg-hover: #2d9cdb;\n  --ncsg-project-link-text: #1f7fb4;\n  --ncsg-project-link-text-hover: #ffffff;\n\n  /* ---------- 自适应 SVG 图标 ---------- */\n  --ncsg-adaptive-icon-fill: #263244;\n  --ncsg-adaptive-icon-fill-hover: #1f7fb4;\n\n  /* ---------- 双列卡片图片尺寸 ---------- */\n  --ncsg-project-double-img-width: 30%;\n  --ncsg-project-double-img-max-width: 150px;\n  --ncsg-project-double-img-height: 160px;\n\n  /* ---------- 单列长条布局尺寸 ---------- */\n  --ncsg-project-list-media-width: 220px;\n  --ncsg-project-list-card-min-height: 170px;\n  --ncsg-project-list-img-size: 200px;\n\n  /* ---------- 窄屏 / 窄容器图片尺寸 ---------- */\n  --ncsg-project-mobile-img-width: 70%;\n  --ncsg-project-mobile-img-max-width: 210px;\n  --ncsg-project-mobile-img-height: 120px;\n\n  /* ---------- 单列布局变为上下结构的容器宽度 ---------- */\n  --ncsg-project-list-stack-breakpoint: 680px;\n}\n\n\n/* =========================================================\n * 2. 系统深色模式兜底\n * ========================================================= */\n\n@media (prefers-color-scheme: dark) {\n  :root {\n    --ncsg-project-card-bg: rgba(30, 39, 50, 0.96);\n    --ncsg-project-card-bg-soft: rgba(33, 43, 55, 0.98);\n    --ncsg-project-card-text: #e8edf3;\n    --ncsg-project-card-muted: #d7dee8;\n    --ncsg-project-card-border: rgba(120, 140, 160, 0.45);\n    --ncsg-project-card-border-hover: #4db6e2;\n    --ncsg-project-card-shadow-hover: 0 10px 28px rgba(0, 0, 0, 0.28);\n\n    --ncsg-project-logo-bg: rgba(15, 23, 32, 0.36);\n\n    --ncsg-project-link-bg: rgba(77, 182, 226, 0.14);\n    --ncsg-project-link-bg-hover: #4db6e2;\n    --ncsg-project-link-text: #8bd4f2;\n    --ncsg-project-link-text-hover: #0d1b24;\n\n    --ncsg-adaptive-icon-fill: #e8edf3;\n    --ncsg-adaptive-icon-fill-hover: #8bd4f2;\n  }\n}\n\n\n/* =========================================================\n * 3. Fluid / Hexo 显式深色模式\n * ========================================================= */\n\nhtml[data-user-color-scheme=\"dark\"],\nbody[data-user-color-scheme=\"dark\"],\n[data-user-color-scheme=\"dark\"],\nhtml.dark,\nbody.dark {\n  --ncsg-project-card-bg: rgba(30, 39, 50, 0.96);\n  --ncsg-project-card-bg-soft: rgba(33, 43, 55, 0.98);\n  --ncsg-project-card-text: #e8edf3;\n  --ncsg-project-card-muted: #d7dee8;\n  --ncsg-project-card-border: rgba(120, 140, 160, 0.45);\n  --ncsg-project-card-border-hover: #4db6e2;\n  --ncsg-project-card-shadow-hover: 0 10px 28px rgba(0, 0, 0, 0.28);\n\n  --ncsg-project-logo-bg: rgba(15, 23, 32, 0.36);\n\n  --ncsg-project-link-bg: rgba(77, 182, 226, 0.14);\n  --ncsg-project-link-bg-hover: #4db6e2;\n  --ncsg-project-link-text: #8bd4f2;\n  --ncsg-project-link-text-hover: #0d1b24;\n\n  --ncsg-adaptive-icon-fill: #e8edf3;\n  --ncsg-adaptive-icon-fill-hover: #8bd4f2;\n}\n\n\n/* =========================================================\n * 4. Fluid / Hexo 显式浅色模式\n * 放在深色模式之后，确保手动切换 light 时可以覆盖系统 dark\n * ========================================================= */\n\nhtml[data-user-color-scheme=\"light\"],\nbody[data-user-color-scheme=\"light\"],\n[data-user-color-scheme=\"light\"],\nhtml.light,\nbody.light {\n  --ncsg-project-card-bg: #ffffff;\n  --ncsg-project-card-bg-soft: #f8fafc;\n  --ncsg-project-card-text: #263244;\n  --ncsg-project-card-muted: #5f6b7a;\n  --ncsg-project-card-border: rgba(80, 100, 120, 0.24);\n  --ncsg-project-card-border-hover: #2d9cdb;\n  --ncsg-project-card-shadow-hover: 0 10px 28px rgba(20, 35, 55, 0.14);\n\n  --ncsg-project-logo-bg: #f3f6fa;\n\n  --ncsg-project-link-bg: rgba(45, 156, 219, 0.10);\n  --ncsg-project-link-bg-hover: #2d9cdb;\n  --ncsg-project-link-text: #1f7fb4;\n  --ncsg-project-link-text-hover: #ffffff;\n\n  --ncsg-adaptive-icon-fill: #263244;\n  --ncsg-adaptive-icon-fill-hover: #1f7fb4;\n}\n\n\n/* =========================================================\n * 5. 基础项目网格\n * 默认：双列卡片布局\n * ========================================================= */\n\n.ncsg-project-grid {\n  display: grid;\n  grid-template-columns: repeat(2, minmax(0, 1fr));\n  gap: 6px;\n  margin-top: 1.8rem;\n  margin-bottom: 2rem;\n\n  /*\n   * 关键修复之一：\n   * 启用 container query。\n   * 这样即使浏览器视口没有小于 768px，\n   * 只要内容区域本身变窄，单列长条也能自动变成上下结构。\n   */\n  container-type: inline-size;\n}\n\n.ncsg-project-card,\n.ncsg-project-card * {\n  box-sizing: border-box;\n}\n\n\n/* =========================================================\n * 6. 基础卡片样式\n * ========================================================= */\n\n.ncsg-project-card {\n  display: flex;\n  flex-direction: column;\n\n  min-height: 340px;\n\n  border: 1px solid var(--ncsg-project-card-border);\n  border-radius: 4px;\n  overflow: hidden;\n\n  text-decoration: none !important;\n  color: var(--ncsg-project-card-text) !important;\n  background: var(--ncsg-project-card-bg);\n\n  transition:\n    transform 0.18s ease,\n    box-shadow 0.18s ease,\n    border-color 0.18s ease;\n}\n\n.ncsg-project-card:hover {\n  transform: translateY(-3px);\n  border-color: var(--ncsg-project-card-border-hover);\n  box-shadow: var(--ncsg-project-card-shadow-hover);\n  text-decoration: none !important;\n}\n\n.ncsg-project-card-header {\n  padding: 1.2rem 1.2rem 1rem;\n\n  text-align: center;\n\n  background: var(--ncsg-project-card-bg);\n  border-bottom: 1px solid var(--ncsg-project-card-border);\n}\n\n.ncsg-project-card-header h3 {\n  margin: 0 0 1rem;\n\n  font-size: 1.05rem;\n  font-weight: 700;\n  line-height: 1.35;\n\n  color: var(--ncsg-project-card-text);\n}\n\n.ncsg-project-card-header img,\n.ncsg-project-card-header svg.icon,\n.ncsg-project-card-header svg.ncsg-adaptive-icon {\n  display: block;\n\n  width: 62%;\n  max-width: 220px;\n  height: 150px;\n\n  object-fit: contain;\n\n  margin: 0 auto;\n\n  opacity: 0.92;\n}\n\n.ncsg-project-card-body {\n  flex: 1;\n\n  padding: 1rem 1.3rem 1.2rem;\n\n  text-align: center;\n\n  background: var(--ncsg-project-card-bg-soft);\n}\n\n.ncsg-project-card-body p {\n  margin: 0;\n\n  line-height: 1.65;\n  font-size: 0.95rem;\n\n  color: var(--ncsg-project-card-muted);\n}\n\n\n/* =========================================================\n * 7. 双列布局中的图片 / SVG 尺寸控制\n * 只作用于普通双列布局，不影响单列长条布局\n * ========================================================= */\n\n.ncsg-project-grid:not(.ncsg-project-grid--list)\n  .ncsg-project-card-header img,\n.ncsg-project-grid:not(.ncsg-project-grid--list)\n  .ncsg-project-card-header svg.icon,\n.ncsg-project-grid:not(.ncsg-project-grid--list)\n  .ncsg-project-card-header svg.ncsg-adaptive-icon {\n  display: block;\n\n  width: var(--ncsg-project-double-img-width);\n  max-width: var(--ncsg-project-double-img-max-width);\n  height: var(--ncsg-project-double-img-height);\n\n  margin: 1rem auto;\n\n  object-fit: contain;\n}\n\n\n/* =========================================================\n * 8. 单列长条布局\n *\n * 使用方式：\n *\n * <div class=\"ncsg-project-grid ncsg-project-grid--list\">\n *   ...\n * </div>\n *\n * 桌面宽屏时：\n * 左侧图片，右侧标题和简介。\n * ========================================================= */\n\n.ncsg-project-grid.ncsg-project-grid--list {\n  grid-template-columns: 1fr;\n  gap: 1rem;\n}\n\n.ncsg-project-grid--list .ncsg-project-card {\n  display: grid;\n  grid-template-columns: var(--ncsg-project-list-media-width) minmax(0, 1fr);\n  grid-template-rows: auto 1fr;\n\n  min-height: var(--ncsg-project-list-card-min-height);\n\n  border-radius: 10px;\n  overflow: hidden;\n}\n\n\n/* 左侧图片区背景 */\n.ncsg-project-grid--list .ncsg-project-card::before {\n  content: \"\";\n\n  grid-column: 1;\n  grid-row: 1 / span 2;\n\n  background: var(--ncsg-project-logo-bg);\n  border-right: 1px solid var(--ncsg-project-card-border);\n\n  z-index: 0;\n}\n\n\n/*\n * 兼容原 HTML 结构：\n *\n * .ncsg-project-card\n *   .ncsg-project-card-header\n *     h3\n *     img\n *   .ncsg-project-card-body\n *     p\n *\n * 宽屏下使用 display: contents，\n * 让 h3 和 img 直接参与 card 的 grid 布局。\n */\n.ncsg-project-grid--list .ncsg-project-card-header {\n  display: contents;\n\n  padding: 0;\n  border-bottom: none;\n  text-align: left;\n}\n\n\n/* 单列长条：左侧图片 / SVG */\n.ncsg-project-grid--list .ncsg-project-card-header img,\n.ncsg-project-grid--list .ncsg-project-card-header svg.icon,\n.ncsg-project-grid--list .ncsg-project-card-header svg.ncsg-adaptive-icon {\n  grid-column: 1;\n  grid-row: 1 / span 2;\n\n  align-self: center;\n  justify-self: center;\n\n  width: var(--ncsg-project-list-img-size);\n  max-width: calc(var(--ncsg-project-list-media-width) - 2rem);\n  height: var(--ncsg-project-list-img-size);\n  min-height: 0;\n\n  padding: 0;\n  margin: 0;\n\n  object-fit: contain;\n\n  background: transparent;\n  border-right: none;\n\n  opacity: 0.96;\n\n  z-index: 1;\n}\n\n\n/* 单列长条：右侧标题 */\n.ncsg-project-grid--list .ncsg-project-card-header h3 {\n  grid-column: 2;\n  grid-row: 1;\n\n  margin: 0;\n  padding: 1.25rem 1.5rem 0.35rem;\n\n  font-size: 1.2rem;\n  font-weight: 700;\n  line-height: 1.35;\n\n  text-align: left;\n\n  color: var(--ncsg-project-card-text);\n\n  z-index: 1;\n}\n\n\n/* 单列长条：右侧简介 */\n.ncsg-project-grid--list .ncsg-project-card-body {\n  grid-column: 2;\n  grid-row: 2;\n\n  min-width: 0;\n\n  padding: 0.25rem 1.5rem 1.25rem;\n\n  text-align: left;\n  background: var(--ncsg-project-card-bg);\n\n  z-index: 1;\n}\n\n.ncsg-project-grid--list .ncsg-project-card-body p {\n  margin: 0;\n  max-width: 760px;\n\n  font-size: 0.98rem;\n  line-height: 1.7;\n\n  color: var(--ncsg-project-card-muted);\n}\n\n\n/* =========================================================\n * 9. Links 按钮样式\n *\n * 如果在 body 中添加：\n *\n * <div class=\"ncsg-project-card-links\">\n *   <a href=\"...\">GitHub</a>\n *   <a href=\"...\">Docs</a>\n * </div>\n *\n * 会自动显示为按钮。\n * ========================================================= */\n\n.ncsg-project-card-links {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 0.5rem;\n\n  margin-top: 1rem;\n}\n\n.ncsg-project-card-links a {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n\n  padding: 0.34rem 0.75rem;\n  border-radius: 999px;\n\n  font-size: 0.85rem;\n  font-weight: 600;\n  line-height: 1.4;\n\n  color: var(--ncsg-project-link-text) !important;\n  background: var(--ncsg-project-link-bg);\n  border: 1px solid rgba(45, 156, 219, 0.28);\n\n  text-decoration: none !important;\n\n  transition:\n    color 0.16s ease,\n    background-color 0.16s ease,\n    border-color 0.16s ease,\n    transform 0.16s ease;\n}\n\n.ncsg-project-card-links a:hover {\n  color: var(--ncsg-project-link-text-hover) !important;\n  background: var(--ncsg-project-link-bg-hover);\n  border-color: var(--ncsg-project-link-bg-hover);\n\n  transform: translateY(-1px);\n  text-decoration: none !important;\n}\n\n\n/* =========================================================\n * 10. 自适应 SVG 图标\n * ========================================================= */\n\n.ncsg-adaptive-icon {\n  transition:\n    fill 0.18s ease,\n    opacity 0.18s ease,\n    transform 0.18s ease;\n}\n\n/* 覆盖 SVG 内部写死的 fill */\n.ncsg-adaptive-icon path:not([fill=\"none\"]),\n.ncsg-adaptive-icon circle:not([fill=\"none\"]),\n.ncsg-adaptive-icon rect:not([fill=\"none\"]),\n.ncsg-adaptive-icon polygon:not([fill=\"none\"]),\n.ncsg-adaptive-icon polyline:not([fill=\"none\"]),\n.ncsg-adaptive-icon ellipse:not([fill=\"none\"]) {\n  fill: var(--ncsg-adaptive-icon-fill) !important;\n  transition: fill 0.18s ease;\n}\n\n/* 兼容 stroke 描边图标 */\n.ncsg-adaptive-icon path[stroke]:not([stroke=\"none\"]),\n.ncsg-adaptive-icon line[stroke]:not([stroke=\"none\"]),\n.ncsg-adaptive-icon circle[stroke]:not([stroke=\"none\"]),\n.ncsg-adaptive-icon rect[stroke]:not([stroke=\"none\"]),\n.ncsg-adaptive-icon polyline[stroke]:not([stroke=\"none\"]),\n.ncsg-adaptive-icon polygon[stroke]:not([stroke=\"none\"]) {\n  stroke: var(--ncsg-adaptive-icon-fill) !important;\n  transition: stroke 0.18s ease;\n}\n\n/* 卡片 hover 时图标变强调色 */\n.ncsg-project-card:hover .ncsg-adaptive-icon path:not([fill=\"none\"]),\n.ncsg-project-card:hover .ncsg-adaptive-icon circle:not([fill=\"none\"]),\n.ncsg-project-card:hover .ncsg-adaptive-icon rect:not([fill=\"none\"]),\n.ncsg-project-card:hover .ncsg-adaptive-icon polygon:not([fill=\"none\"]),\n.ncsg-project-card:hover .ncsg-adaptive-icon polyline:not([fill=\"none\"]),\n.ncsg-project-card:hover .ncsg-adaptive-icon ellipse:not([fill=\"none\"]) {\n  fill: var(--ncsg-adaptive-icon-fill-hover) !important;\n}\n\n.ncsg-project-card:hover .ncsg-adaptive-icon path[stroke]:not([stroke=\"none\"]),\n.ncsg-project-card:hover .ncsg-adaptive-icon line[stroke]:not([stroke=\"none\"]),\n.ncsg-project-card:hover .ncsg-adaptive-icon circle[stroke]:not([stroke=\"none\"]),\n.ncsg-project-card:hover .ncsg-adaptive-icon rect[stroke]:not([stroke=\"none\"]),\n.ncsg-project-card:hover .ncsg-adaptive-icon polyline[stroke]:not([stroke=\"none\"]),\n.ncsg-project-card:hover .ncsg-adaptive-icon polygon[stroke]:not([stroke=\"none\"]) {\n  stroke: var(--ncsg-adaptive-icon-fill-hover) !important;\n}\n\n\n/* =========================================================\n * 11. 普通双列布局的移动端响应\n * 非 .ncsg-project-grid--list 时使用\n * ========================================================= */\n\n@media (max-width: 768px) {\n  .ncsg-project-grid:not(.ncsg-project-grid--list) {\n    grid-template-columns: 1fr;\n  }\n\n  .ncsg-project-grid:not(.ncsg-project-grid--list) .ncsg-project-card {\n    min-height: auto;\n  }\n\n  .ncsg-project-grid:not(.ncsg-project-grid--list)\n    .ncsg-project-card-header img,\n  .ncsg-project-grid:not(.ncsg-project-grid--list)\n    .ncsg-project-card-header svg.icon,\n  .ncsg-project-grid:not(.ncsg-project-grid--list)\n    .ncsg-project-card-header svg.ncsg-adaptive-icon {\n    width: 55%;\n    height: 130px;\n  }\n}\n\n\n/* =========================================================\n * 12. 单列长条布局在窄容器下自动变为：\n *\n * 标题\n * 图片\n * 简介\n *\n * 这是修复你截图中 bug 的关键部分。\n *\n * 使用 container query，而不是只依赖浏览器 viewport。\n * ========================================================= */\n\n@container (max-width: 680px) {\n  .ncsg-project-grid--list .ncsg-project-card {\n    display: grid;\n    grid-template-columns: 1fr;\n    grid-template-rows: auto auto;\n\n    min-height: auto;\n  }\n\n  .ncsg-project-grid--list .ncsg-project-card::before {\n    display: none;\n  }\n\n  .ncsg-project-grid--list .ncsg-project-card-header {\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n\n    grid-column: 1;\n    grid-row: 1;\n\n    padding: 1.1rem 2.5rem 0.9rem;\n\n    text-align: center;\n\n    background: var(--ncsg-project-logo-bg);\n    border-bottom: 1px solid var(--ncsg-project-card-border);\n  }\n\n  .ncsg-project-grid--list .ncsg-project-card-header h3 {\n    order: 1;\n\n    grid-column: auto;\n    grid-row: auto;\n\n    margin: 0 0 0.75rem;\n    padding: 0;\n\n    font-size: 1.1rem;\n    line-height: 1.35;\n    text-align: center;\n  }\n\n  .ncsg-project-grid--list .ncsg-project-card-header img,\n  .ncsg-project-grid--list .ncsg-project-card-header svg.icon,\n  .ncsg-project-grid--list .ncsg-project-card-header svg.ncsg-adaptive-icon {\n    order: 2;\n\n    grid-column: auto;\n    grid-row: auto;\n\n    align-self: center;\n    justify-self: center;\n\n    width: var(--ncsg-project-mobile-img-width);\n    max-width: var(--ncsg-project-mobile-img-max-width);\n    height: var(--ncsg-project-mobile-img-height);\n    min-height: 0;\n\n    margin: 0 auto;\n    padding: 0;\n\n    object-fit: contain;\n\n    background: transparent;\n    border-right: none;\n  }\n\n  .ncsg-project-grid--list .ncsg-project-card-body {\n    grid-column: 1;\n    grid-row: 2;\n\n    padding: 1rem 2.5rem 1.25rem;\n\n    text-align: center;\n\n    background: var(--ncsg-project-card-bg);\n  }\n\n  .ncsg-project-grid--list .ncsg-project-card-body p {\n    max-width: none;\n\n    font-size: 0.95rem;\n    line-height: 1.7;\n  }\n\n  .ncsg-project-grid--list .ncsg-project-card-links {\n    justify-content: center;\n  }\n}\n\n\n/* =========================================================\n * 13. 兼容不支持 container query 的浏览器\n * 当视口过窄时，也强制切换为上下结构\n * ========================================================= */\n\n@media (max-width: 768px) {\n  .ncsg-project-grid.ncsg-project-grid--list {\n    gap: 1rem;\n  }\n\n  .ncsg-project-grid--list .ncsg-project-card {\n    display: grid;\n    grid-template-columns: 1fr;\n    grid-template-rows: auto auto;\n\n    min-height: auto;\n  }\n\n  .ncsg-project-grid--list .ncsg-project-card::before {\n    display: none;\n  }\n\n  .ncsg-project-grid--list .ncsg-project-card-header {\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n\n    grid-column: 1;\n    grid-row: 1;\n\n    padding: 1.1rem 1.2rem 0.9rem;\n\n    text-align: center;\n\n    background: var(--ncsg-project-logo-bg);\n    border-bottom: 1px solid var(--ncsg-project-card-border);\n  }\n\n  .ncsg-project-grid--list .ncsg-project-card-header h3 {\n    order: 1;\n\n    grid-column: auto;\n    grid-row: auto;\n\n    margin: 0 0 0.75rem;\n    padding: 0;\n\n    font-size: 1.1rem;\n    line-height: 1.35;\n    text-align: center;\n  }\n\n  .ncsg-project-grid--list .ncsg-project-card-header img,\n  .ncsg-project-grid--list .ncsg-project-card-header svg.icon,\n  .ncsg-project-grid--list .ncsg-project-card-header svg.ncsg-adaptive-icon {\n    order: 2;\n\n    grid-column: auto;\n    grid-row: auto;\n\n    align-self: center;\n    justify-self: center;\n\n    width: var(--ncsg-project-mobile-img-width);\n    max-width: var(--ncsg-project-mobile-img-max-width);\n    height: var(--ncsg-project-mobile-img-height);\n    min-height: 0;\n\n    margin: 0 auto;\n    padding: 0;\n\n    object-fit: contain;\n\n    background: transparent;\n    border-right: none;\n  }\n\n  .ncsg-project-grid--list .ncsg-project-card-body {\n    grid-column: 1;\n    grid-row: 2;\n\n    padding: 1rem 1.2rem 1.25rem;\n\n    text-align: center;\n\n    background: var(--ncsg-project-card-bg);\n  }\n\n  .ncsg-project-grid--list .ncsg-project-card-body p {\n    max-width: none;\n\n    font-size: 0.95rem;\n    line-height: 1.7;\n  }\n\n  .ncsg-project-grid--list .ncsg-project-card-links {\n    justify-content: center;\n  }\n}"},{"_content":"(function () {\n  const ICONS = {\n    copy:\n      '<svg viewBox=\"0 0 24 24\" aria-hidden=\"true\">' +\n      '<rect x=\"9\" y=\"9\" width=\"13\" height=\"13\" rx=\"2\"></rect>' +\n      '<path d=\"M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1\"></path>' +\n      \"</svg>\",\n\n    copied:\n      '<svg viewBox=\"0 0 24 24\" aria-hidden=\"true\">' +\n      '<path d=\"M20 6L9 17l-5-5\"></path>' +\n      \"</svg>\",\n\n    failed:\n      '<svg viewBox=\"0 0 24 24\" aria-hidden=\"true\">' +\n      '<path d=\"M18 6L6 18\"></path>' +\n      '<path d=\"M6 6l12 12\"></path>' +\n      \"</svg>\",\n\n    expand:\n      '<svg viewBox=\"0 0 24 24\" aria-hidden=\"true\">' +\n      '<path d=\"M7 13l5 5 5-5\"></path>' +\n      '<path d=\"M7 7l5 5 5-5\"></path>' +\n      \"</svg>\",\n\n    collapse:\n      '<svg viewBox=\"0 0 24 24\" aria-hidden=\"true\">' +\n      '<path d=\"M7 13l5-5 5 5\"></path>' +\n      '<path d=\"M7 19l5-5 5 5\"></path>' +\n      \"</svg>\"\n  };\n\n  function setButtonIcon(button, iconName, label) {\n    button.innerHTML = ICONS[iconName] || \"\";\n    button.setAttribute(\"aria-label\", label);\n    button.setAttribute(\"title\", label);\n  }\n\n  function getLanguageName(figure) {\n  if (!figure) {\n    return \"\";\n  }\n\n  /*\n   * Hexo highlight 常见形式：\n   * <figure class=\"highlight python\">\n   */\n  const ignoredClasses = new Set([\n    \"highlight\",\n    \"ncsg-code-enhanced\",\n    \"ncsg-code-expanded\"\n  ]);\n\n  let lang = \"\";\n\n  figure.classList.forEach(function (cls) {\n    if (!ignoredClasses.has(cls) && !cls.startsWith(\"ncsg-\")) {\n      lang = cls;\n    }\n  });\n\n  /*\n   * fallback:\n   * 某些渲染器可能生成：\n   * <code class=\"language-python\">\n   * <code class=\"lang-python\">\n   */\n  if (!lang) {\n    const code = figure.querySelector(\"code[class*='language-'], code[class*='lang-']\");\n    if (code) {\n      code.classList.forEach(function (cls) {\n        if (cls.startsWith(\"language-\")) {\n          lang = cls.replace(/^language-/, \"\");\n        } else if (cls.startsWith(\"lang-\")) {\n          lang = cls.replace(/^lang-/, \"\");\n        }\n      });\n    }\n  }\n\n  if (!lang) {\n    return \"\";\n  }\n\n  lang = lang.toLowerCase();\n\n  /*\n   * 显示名映射。\n   * 你可以继续按需添加。\n   */\n  const languageMap = {\n    py: \"Python\",\n    python: \"Python\",\n    js: \"JavaScript\",\n    javascript: \"JavaScript\",\n    ts: \"TypeScript\",\n    typescript: \"TypeScript\",\n    html: \"HTML\",\n    xml: \"XML\",\n    css: \"CSS\",\n    scss: \"SCSS\",\n    sass: \"Sass\",\n    json: \"JSON\",\n    yaml: \"YAML\",\n    yml: \"YAML\",\n    bash: \"Bash\",\n    sh: \"Shell\",\n    shell: \"Shell\",\n    zsh: \"Zsh\",\n    powershell: \"PowerShell\",\n    ps1: \"PowerShell\",\n    c: \"C\",\n    cpp: \"C++\",\n    \"c++\": \"C++\",\n    cxx: \"C++\",\n    hpp: \"C++\",\n    java: \"Java\",\n    kotlin: \"Kotlin\",\n    go: \"Go\",\n    rust: \"Rust\",\n    rs: \"Rust\",\n    ruby: \"Ruby\",\n    php: \"PHP\",\n    sql: \"SQL\",\n    r: \"R\",\n    matlab: \"MATLAB\",\n    tex: \"TeX\",\n    latex: \"LaTeX\",\n    markdown: \"Markdown\",\n    md: \"Markdown\",\n    dockerfile: \"Dockerfile\",\n    makefile: \"Makefile\",\n    toml: \"TOML\",\n    ini: \"INI\"\n  };\n\n  if (languageMap[lang]) {\n    return languageMap[lang];\n  }\n\n  /*\n   * 默认首字母大写。\n   */\n  return lang.charAt(0).toUpperCase() + lang.slice(1);\n}\n\n  function getCodeText(figure) {\n    const codePre =\n      figure.querySelector(\"td.code pre\") ||\n      figure.querySelector(\"pre code\") ||\n      figure.querySelector(\"pre\");\n\n    if (!codePre) {\n      return \"\";\n    }\n\n    const lines = codePre.querySelectorAll(\".line\");\n\n    if (lines && lines.length > 0) {\n      return Array.from(lines)\n        .map(function (line) {\n          return line.textContent || \"\";\n        })\n        .join(\"\\n\")\n        .replace(/\\n+$/, \"\");\n    }\n\n    return (codePre.innerText || codePre.textContent || \"\").replace(/\\n+$/, \"\");\n  }\n\n  function copyText(text) {\n    if (navigator.clipboard && window.isSecureContext) {\n      return navigator.clipboard.writeText(text);\n    }\n\n    return new Promise(function (resolve, reject) {\n      const textarea = document.createElement(\"textarea\");\n      textarea.value = text;\n\n      textarea.setAttribute(\"readonly\", \"\");\n      textarea.style.position = \"fixed\";\n      textarea.style.left = \"-9999px\";\n      textarea.style.top = \"-9999px\";\n\n      document.body.appendChild(textarea);\n      textarea.focus();\n      textarea.select();\n\n      try {\n        const successful = document.execCommand(\"copy\");\n        document.body.removeChild(textarea);\n\n        if (successful) {\n          resolve();\n        } else {\n          reject(new Error(\"copy command failed\"));\n        }\n      } catch (err) {\n        document.body.removeChild(textarea);\n        reject(err);\n      }\n    });\n  }\n\n  function updateToggleVisibility(figure, scrollBox, toggleBtn) {\n    if (!figure || !scrollBox || !toggleBtn) {\n      return;\n    }\n\n    /*\n     * 如果当前已经展开，先不强行重新计算。\n     * 否则在 resize 时可能造成视觉跳动。\n     */\n    if (figure.classList.contains(\"ncsg-code-expanded\")) {\n      toggleBtn.classList.remove(\"ncsg-code-toggle-hidden\");\n      return;\n    }\n\n    /*\n     * 判断是否真的需要纵向滚动。\n     * scrollHeight 是完整内容高度。\n     * clientHeight 是当前可见高度。\n     */\n    const needsToggle = scrollBox.scrollHeight > scrollBox.clientHeight + 2;\n\n    if (needsToggle) {\n      toggleBtn.classList.remove(\"ncsg-code-toggle-hidden\");\n      toggleBtn.disabled = false;\n    } else {\n      toggleBtn.classList.add(\"ncsg-code-toggle-hidden\");\n      toggleBtn.disabled = true;\n\n      figure.classList.remove(\"ncsg-code-expanded\");\n      setButtonIcon(toggleBtn, \"expand\", \"expand\");\n      toggleBtn.setAttribute(\"aria-expanded\", \"false\");\n    }\n  }\n\n  function enhanceCodeBlock(figure) {\n    if (!figure || figure.classList.contains(\"ncsg-code-enhanced\")) {\n      return;\n    }\n\n    const table = figure.querySelector(\":scope > table\") || figure.querySelector(\"table\");\n\n    if (!table) {\n      return;\n    }\n\n    figure.classList.add(\"ncsg-code-enhanced\");\n\nconst toolbar = document.createElement(\"div\");\ntoolbar.className = \"ncsg-code-toolbar\";\n\n/*\n * 左侧语言标签\n */\nconst langLabel = document.createElement(\"div\");\nlangLabel.className = \"ncsg-code-lang\";\nlangLabel.textContent = getLanguageName(figure);\n\n/*\n * 右侧按钮区\n */\nconst actions = document.createElement(\"div\");\nactions.className = \"ncsg-code-actions\";\n\nconst toggleBtn = document.createElement(\"button\");\ntoggleBtn.type = \"button\";\ntoggleBtn.className = \"ncsg-code-btn ncsg-code-toggle\";\nsetButtonIcon(toggleBtn, \"expand\", \"展开代码\");\ntoggleBtn.setAttribute(\"aria-expanded\", \"false\");\n\nconst copyBtn = document.createElement(\"button\");\ncopyBtn.type = \"button\";\ncopyBtn.className = \"ncsg-code-btn ncsg-code-copy\";\nsetButtonIcon(copyBtn, \"copy\", \"复制代码\");\n\nactions.appendChild(toggleBtn);\nactions.appendChild(copyBtn);\n\ntoolbar.appendChild(langLabel);\ntoolbar.appendChild(actions);\n\n    let scrollBox = table.parentElement;\n\n    if (!scrollBox || !scrollBox.classList.contains(\"ncsg-code-scroll\")) {\n      scrollBox = document.createElement(\"div\");\n      scrollBox.className = \"ncsg-code-scroll\";\n\n      table.parentNode.insertBefore(scrollBox, table);\n      scrollBox.appendChild(table);\n    }\n\n    figure.insertBefore(toolbar, figure.firstChild);\n\n    toggleBtn.addEventListener(\"click\", function () {\n      const expanded = figure.classList.toggle(\"ncsg-code-expanded\");\n\n      if (expanded) {\n        setButtonIcon(toggleBtn, \"collapse\", \"collapse\");\n        toggleBtn.setAttribute(\"aria-expanded\", \"true\");\n      } else {\n        setButtonIcon(toggleBtn, \"expand\", \"expand\");\n        toggleBtn.setAttribute(\"aria-expanded\", \"false\");\n\n        /*\n         * 折叠回去后，把滚动位置重置到顶部。\n         * 如果你希望保留原滚动位置，可以删掉这两行。\n         */\n        scrollBox.scrollTop = 0;\n      }\n    });\n\n    copyBtn.addEventListener(\"click\", function () {\n      const code = getCodeText(figure);\n\n      if (!code) {\n        copyBtn.classList.add(\"ncsg-code-failed\");\n        setButtonIcon(copyBtn, \"failed\", \"failed\");\n\n        setTimeout(function () {\n          copyBtn.classList.remove(\"ncsg-code-failed\");\n          setButtonIcon(copyBtn, \"copy\", \"copy\");\n        }, 1200);\n\n        return;\n      }\n\n      copyText(code)\n        .then(function () {\n          copyBtn.classList.add(\"ncsg-code-copied\");\n          setButtonIcon(copyBtn, \"copied\", \"copied\");\n\n          setTimeout(function () {\n            copyBtn.classList.remove(\"ncsg-code-copied\");\n            setButtonIcon(copyBtn, \"copy\", \"copy\");\n          }, 1200);\n        })\n        .catch(function () {\n          copyBtn.classList.add(\"ncsg-code-failed\");\n          setButtonIcon(copyBtn, \"failed\", \"failed\");\n\n          setTimeout(function () {\n            copyBtn.classList.remove(\"ncsg-code-failed\");\n            setButtonIcon(copyBtn, \"copy\", \"copy\");\n          }, 1500);\n        });\n    });\n\n    /*\n     * 等浏览器完成布局后再判断是否需要展开按钮。\n     * 否则刚插入 DOM 时高度可能还没稳定。\n     */\n    requestAnimationFrame(function () {\n      updateToggleVisibility(figure, scrollBox, toggleBtn);\n    });\n\n    /*\n     * 字体加载完成后，高度可能变化，再判断一次。\n     */\n    if (document.fonts && document.fonts.ready) {\n      document.fonts.ready.then(function () {\n        updateToggleVisibility(figure, scrollBox, toggleBtn);\n      });\n    }\n\n    /*\n     * 窗口尺寸变化后重新判断。\n     */\n    let resizeTimer = null;\n\n    window.addEventListener(\"resize\", function () {\n      clearTimeout(resizeTimer);\n\n      resizeTimer = setTimeout(function () {\n        updateToggleVisibility(figure, scrollBox, toggleBtn);\n      }, 150);\n    });\n  }\n\n  function initCodeTools() {\n    const figures = document.querySelectorAll(\"figure.highlight\");\n\n    figures.forEach(function (figure) {\n      enhanceCodeBlock(figure);\n    });\n  }\n\n  if (document.readyState === \"loading\") {\n    document.addEventListener(\"DOMContentLoaded\", initCodeTools);\n  } else {\n    initCodeTools();\n  }\n})();","source":"js/ncsg-code-tools.js","raw":"(function () {\n  const ICONS = {\n    copy:\n      '<svg viewBox=\"0 0 24 24\" aria-hidden=\"true\">' +\n      '<rect x=\"9\" y=\"9\" width=\"13\" height=\"13\" rx=\"2\"></rect>' +\n      '<path d=\"M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1\"></path>' +\n      \"</svg>\",\n\n    copied:\n      '<svg viewBox=\"0 0 24 24\" aria-hidden=\"true\">' +\n      '<path d=\"M20 6L9 17l-5-5\"></path>' +\n      \"</svg>\",\n\n    failed:\n      '<svg viewBox=\"0 0 24 24\" aria-hidden=\"true\">' +\n      '<path d=\"M18 6L6 18\"></path>' +\n      '<path d=\"M6 6l12 12\"></path>' +\n      \"</svg>\",\n\n    expand:\n      '<svg viewBox=\"0 0 24 24\" aria-hidden=\"true\">' +\n      '<path d=\"M7 13l5 5 5-5\"></path>' +\n      '<path d=\"M7 7l5 5 5-5\"></path>' +\n      \"</svg>\",\n\n    collapse:\n      '<svg viewBox=\"0 0 24 24\" aria-hidden=\"true\">' +\n      '<path d=\"M7 13l5-5 5 5\"></path>' +\n      '<path d=\"M7 19l5-5 5 5\"></path>' +\n      \"</svg>\"\n  };\n\n  function setButtonIcon(button, iconName, label) {\n    button.innerHTML = ICONS[iconName] || \"\";\n    button.setAttribute(\"aria-label\", label);\n    button.setAttribute(\"title\", label);\n  }\n\n  function getLanguageName(figure) {\n  if (!figure) {\n    return \"\";\n  }\n\n  /*\n   * Hexo highlight 常见形式：\n   * <figure class=\"highlight python\">\n   */\n  const ignoredClasses = new Set([\n    \"highlight\",\n    \"ncsg-code-enhanced\",\n    \"ncsg-code-expanded\"\n  ]);\n\n  let lang = \"\";\n\n  figure.classList.forEach(function (cls) {\n    if (!ignoredClasses.has(cls) && !cls.startsWith(\"ncsg-\")) {\n      lang = cls;\n    }\n  });\n\n  /*\n   * fallback:\n   * 某些渲染器可能生成：\n   * <code class=\"language-python\">\n   * <code class=\"lang-python\">\n   */\n  if (!lang) {\n    const code = figure.querySelector(\"code[class*='language-'], code[class*='lang-']\");\n    if (code) {\n      code.classList.forEach(function (cls) {\n        if (cls.startsWith(\"language-\")) {\n          lang = cls.replace(/^language-/, \"\");\n        } else if (cls.startsWith(\"lang-\")) {\n          lang = cls.replace(/^lang-/, \"\");\n        }\n      });\n    }\n  }\n\n  if (!lang) {\n    return \"\";\n  }\n\n  lang = lang.toLowerCase();\n\n  /*\n   * 显示名映射。\n   * 你可以继续按需添加。\n   */\n  const languageMap = {\n    py: \"Python\",\n    python: \"Python\",\n    js: \"JavaScript\",\n    javascript: \"JavaScript\",\n    ts: \"TypeScript\",\n    typescript: \"TypeScript\",\n    html: \"HTML\",\n    xml: \"XML\",\n    css: \"CSS\",\n    scss: \"SCSS\",\n    sass: \"Sass\",\n    json: \"JSON\",\n    yaml: \"YAML\",\n    yml: \"YAML\",\n    bash: \"Bash\",\n    sh: \"Shell\",\n    shell: \"Shell\",\n    zsh: \"Zsh\",\n    powershell: \"PowerShell\",\n    ps1: \"PowerShell\",\n    c: \"C\",\n    cpp: \"C++\",\n    \"c++\": \"C++\",\n    cxx: \"C++\",\n    hpp: \"C++\",\n    java: \"Java\",\n    kotlin: \"Kotlin\",\n    go: \"Go\",\n    rust: \"Rust\",\n    rs: \"Rust\",\n    ruby: \"Ruby\",\n    php: \"PHP\",\n    sql: \"SQL\",\n    r: \"R\",\n    matlab: \"MATLAB\",\n    tex: \"TeX\",\n    latex: \"LaTeX\",\n    markdown: \"Markdown\",\n    md: \"Markdown\",\n    dockerfile: \"Dockerfile\",\n    makefile: \"Makefile\",\n    toml: \"TOML\",\n    ini: \"INI\"\n  };\n\n  if (languageMap[lang]) {\n    return languageMap[lang];\n  }\n\n  /*\n   * 默认首字母大写。\n   */\n  return lang.charAt(0).toUpperCase() + lang.slice(1);\n}\n\n  function getCodeText(figure) {\n    const codePre =\n      figure.querySelector(\"td.code pre\") ||\n      figure.querySelector(\"pre code\") ||\n      figure.querySelector(\"pre\");\n\n    if (!codePre) {\n      return \"\";\n    }\n\n    const lines = codePre.querySelectorAll(\".line\");\n\n    if (lines && lines.length > 0) {\n      return Array.from(lines)\n        .map(function (line) {\n          return line.textContent || \"\";\n        })\n        .join(\"\\n\")\n        .replace(/\\n+$/, \"\");\n    }\n\n    return (codePre.innerText || codePre.textContent || \"\").replace(/\\n+$/, \"\");\n  }\n\n  function copyText(text) {\n    if (navigator.clipboard && window.isSecureContext) {\n      return navigator.clipboard.writeText(text);\n    }\n\n    return new Promise(function (resolve, reject) {\n      const textarea = document.createElement(\"textarea\");\n      textarea.value = text;\n\n      textarea.setAttribute(\"readonly\", \"\");\n      textarea.style.position = \"fixed\";\n      textarea.style.left = \"-9999px\";\n      textarea.style.top = \"-9999px\";\n\n      document.body.appendChild(textarea);\n      textarea.focus();\n      textarea.select();\n\n      try {\n        const successful = document.execCommand(\"copy\");\n        document.body.removeChild(textarea);\n\n        if (successful) {\n          resolve();\n        } else {\n          reject(new Error(\"copy command failed\"));\n        }\n      } catch (err) {\n        document.body.removeChild(textarea);\n        reject(err);\n      }\n    });\n  }\n\n  function updateToggleVisibility(figure, scrollBox, toggleBtn) {\n    if (!figure || !scrollBox || !toggleBtn) {\n      return;\n    }\n\n    /*\n     * 如果当前已经展开，先不强行重新计算。\n     * 否则在 resize 时可能造成视觉跳动。\n     */\n    if (figure.classList.contains(\"ncsg-code-expanded\")) {\n      toggleBtn.classList.remove(\"ncsg-code-toggle-hidden\");\n      return;\n    }\n\n    /*\n     * 判断是否真的需要纵向滚动。\n     * scrollHeight 是完整内容高度。\n     * clientHeight 是当前可见高度。\n     */\n    const needsToggle = scrollBox.scrollHeight > scrollBox.clientHeight + 2;\n\n    if (needsToggle) {\n      toggleBtn.classList.remove(\"ncsg-code-toggle-hidden\");\n      toggleBtn.disabled = false;\n    } else {\n      toggleBtn.classList.add(\"ncsg-code-toggle-hidden\");\n      toggleBtn.disabled = true;\n\n      figure.classList.remove(\"ncsg-code-expanded\");\n      setButtonIcon(toggleBtn, \"expand\", \"expand\");\n      toggleBtn.setAttribute(\"aria-expanded\", \"false\");\n    }\n  }\n\n  function enhanceCodeBlock(figure) {\n    if (!figure || figure.classList.contains(\"ncsg-code-enhanced\")) {\n      return;\n    }\n\n    const table = figure.querySelector(\":scope > table\") || figure.querySelector(\"table\");\n\n    if (!table) {\n      return;\n    }\n\n    figure.classList.add(\"ncsg-code-enhanced\");\n\nconst toolbar = document.createElement(\"div\");\ntoolbar.className = \"ncsg-code-toolbar\";\n\n/*\n * 左侧语言标签\n */\nconst langLabel = document.createElement(\"div\");\nlangLabel.className = \"ncsg-code-lang\";\nlangLabel.textContent = getLanguageName(figure);\n\n/*\n * 右侧按钮区\n */\nconst actions = document.createElement(\"div\");\nactions.className = \"ncsg-code-actions\";\n\nconst toggleBtn = document.createElement(\"button\");\ntoggleBtn.type = \"button\";\ntoggleBtn.className = \"ncsg-code-btn ncsg-code-toggle\";\nsetButtonIcon(toggleBtn, \"expand\", \"展开代码\");\ntoggleBtn.setAttribute(\"aria-expanded\", \"false\");\n\nconst copyBtn = document.createElement(\"button\");\ncopyBtn.type = \"button\";\ncopyBtn.className = \"ncsg-code-btn ncsg-code-copy\";\nsetButtonIcon(copyBtn, \"copy\", \"复制代码\");\n\nactions.appendChild(toggleBtn);\nactions.appendChild(copyBtn);\n\ntoolbar.appendChild(langLabel);\ntoolbar.appendChild(actions);\n\n    let scrollBox = table.parentElement;\n\n    if (!scrollBox || !scrollBox.classList.contains(\"ncsg-code-scroll\")) {\n      scrollBox = document.createElement(\"div\");\n      scrollBox.className = \"ncsg-code-scroll\";\n\n      table.parentNode.insertBefore(scrollBox, table);\n      scrollBox.appendChild(table);\n    }\n\n    figure.insertBefore(toolbar, figure.firstChild);\n\n    toggleBtn.addEventListener(\"click\", function () {\n      const expanded = figure.classList.toggle(\"ncsg-code-expanded\");\n\n      if (expanded) {\n        setButtonIcon(toggleBtn, \"collapse\", \"collapse\");\n        toggleBtn.setAttribute(\"aria-expanded\", \"true\");\n      } else {\n        setButtonIcon(toggleBtn, \"expand\", \"expand\");\n        toggleBtn.setAttribute(\"aria-expanded\", \"false\");\n\n        /*\n         * 折叠回去后，把滚动位置重置到顶部。\n         * 如果你希望保留原滚动位置，可以删掉这两行。\n         */\n        scrollBox.scrollTop = 0;\n      }\n    });\n\n    copyBtn.addEventListener(\"click\", function () {\n      const code = getCodeText(figure);\n\n      if (!code) {\n        copyBtn.classList.add(\"ncsg-code-failed\");\n        setButtonIcon(copyBtn, \"failed\", \"failed\");\n\n        setTimeout(function () {\n          copyBtn.classList.remove(\"ncsg-code-failed\");\n          setButtonIcon(copyBtn, \"copy\", \"copy\");\n        }, 1200);\n\n        return;\n      }\n\n      copyText(code)\n        .then(function () {\n          copyBtn.classList.add(\"ncsg-code-copied\");\n          setButtonIcon(copyBtn, \"copied\", \"copied\");\n\n          setTimeout(function () {\n            copyBtn.classList.remove(\"ncsg-code-copied\");\n            setButtonIcon(copyBtn, \"copy\", \"copy\");\n          }, 1200);\n        })\n        .catch(function () {\n          copyBtn.classList.add(\"ncsg-code-failed\");\n          setButtonIcon(copyBtn, \"failed\", \"failed\");\n\n          setTimeout(function () {\n            copyBtn.classList.remove(\"ncsg-code-failed\");\n            setButtonIcon(copyBtn, \"copy\", \"copy\");\n          }, 1500);\n        });\n    });\n\n    /*\n     * 等浏览器完成布局后再判断是否需要展开按钮。\n     * 否则刚插入 DOM 时高度可能还没稳定。\n     */\n    requestAnimationFrame(function () {\n      updateToggleVisibility(figure, scrollBox, toggleBtn);\n    });\n\n    /*\n     * 字体加载完成后，高度可能变化，再判断一次。\n     */\n    if (document.fonts && document.fonts.ready) {\n      document.fonts.ready.then(function () {\n        updateToggleVisibility(figure, scrollBox, toggleBtn);\n      });\n    }\n\n    /*\n     * 窗口尺寸变化后重新判断。\n     */\n    let resizeTimer = null;\n\n    window.addEventListener(\"resize\", function () {\n      clearTimeout(resizeTimer);\n\n      resizeTimer = setTimeout(function () {\n        updateToggleVisibility(figure, scrollBox, toggleBtn);\n      }, 150);\n    });\n  }\n\n  function initCodeTools() {\n    const figures = document.querySelectorAll(\"figure.highlight\");\n\n    figures.forEach(function (figure) {\n      enhanceCodeBlock(figure);\n    });\n  }\n\n  if (document.readyState === \"loading\") {\n    document.addEventListener(\"DOMContentLoaded\", initCodeTools);\n  } else {\n    initCodeTools();\n  }\n})();","date":"2026-07-31T03:30:16.617Z","updated":"2026-07-31T03:30:16.617Z","path":"js/ncsg-code-tools.js","layout":"false","title":"","comments":1,"_id":"cuidX6zNBpzn0xxrYoDSnTUPg","content":"(function () {\n  const ICONS = {\n    copy:\n      '<svg viewBox=\"0 0 24 24\" aria-hidden=\"true\">' +\n      '<rect x=\"9\" y=\"9\" width=\"13\" height=\"13\" rx=\"2\"></rect>' +\n      '<path d=\"M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1\"></path>' +\n      \"</svg>\",\n\n    copied:\n      '<svg viewBox=\"0 0 24 24\" aria-hidden=\"true\">' +\n      '<path d=\"M