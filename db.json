n      textarea.style.position = \"fixed\";\n      textarea.style.left = \"-9999px\";\n      textarea.style.top = \"-9999px\";\n\n      document.body.appendChild(textarea);\n      textarea.focus();\n      textarea.select();\n\n      try {\n        const successful = document.execCommand(\"copy\");\n        document.body.removeChild(textarea);\n\n        if (successful) {\n          resolve();\n        } else {\n          reject(new Error(\"copy command failed\"));\n        }\n      } catch (err) {\n        document.body.removeChild(textarea);\n        reject(err);\n      }\n    });\n  }\n\n  function updateToggleVisibility(figure, scrollBox, toggleBtn) {\n    if (!figure || !scrollBox || !toggleBtn) {\n      return;\n    }\n\n    /*\n     * 如果当前已经展开，先不强行重新计算。\n     * 否则在 resize 时可能造成视觉跳动。\n     */\n    if (figure.classList.contains(\"ncsg-code-expanded\")) {\n      toggleBtn.classList.remove(\"ncsg-code-toggle-hidden\");\n      return;\n    }\n\n    /*\n     * 判断是否真的需要纵向滚动。\n     * scrollHeight 是完整内容高度。\n     * clientHeight 是当前可见高度。\n     */\n    const needsToggle = scrollBox.scrollHeight > scrollBox.clientHeight + 2;\n\n    if (needsToggle) {\n      toggleBtn.classList.remove(\"ncsg-code-toggle-hidden\");\n      toggleBtn.disabled = false;\n    } else {\n      toggleBtn.classList.add(\"ncsg-code-toggle-hidden\");\n      toggleBtn.disabled = true;\n\n      figure.classList.remove(\"ncsg-code-expanded\");\n      setButtonIcon(toggleBtn, \"expand\", \"expand\");\n      toggleBtn.setAttribute(\"aria-expanded\", \"false\");\n    }\n  }\n\n  function enhanceCodeBlock(figure) {\n    if (!figure || figure.classList.contains(\"ncsg-code-enhanced\")) {\n      return;\n    }\n\n    const table = figure.querySelector(\":scope > table\") || figure.querySelector(\"table\");\n\n    if (!table) {\n      return;\n    }\n\n    figure.classList.add(\"ncsg-code-enhanced\");\n\nconst toolbar = document.createElement(\"div\");\ntoolbar.className = \"ncsg-code-toolbar\";\n\n/*\n * 左侧语言标签\n */\nconst langLabel = document.createElement(\"div\");\nlangLabel.className = \"ncsg-code-lang\";\nlangLabel.textContent = getLanguageName(figure);\n\n/*\n * 右侧按钮区\n */\nconst actions = document.createElement(\"div\");\nactions.className = \"ncsg-code-actions\";\n\nconst toggleBtn = document.createElement(\"button\");\ntoggleBtn.type = \"button\";\ntoggleBtn.className = \"ncsg-code-btn ncsg-code-toggle\";\nsetButtonIcon(toggleBtn, \"expand\", \"展开代码\");\ntoggleBtn.setAttribute(\"aria-expanded\", \"false\");\n\nconst copyBtn = document.createElement(\"button\");\ncopyBtn.type = \"button\";\ncopyBtn.className = \"ncsg-code-btn ncsg-code-copy\";\nsetButtonIcon(copyBtn, \"copy\", \"复制代码\");\n\nactions.appendChild(toggleBtn);\nactions.appendChild(copyBtn);\n\ntoolbar.appendChild(langLabel);\ntoolbar.appendChild(actions);\n\n    let scrollBox = table.parentElement;\n\n    if (!scrollBox || !scrollBox.classList.contains(\"ncsg-code-scroll\")) {\n      scrollBox = document.createElement(\"div\");\n      scrollBox.className = \"ncsg-code-scroll\";\n\n      table.parentNode.insertBefore(scrollBox, table);\n      scrollBox.appendChild(table);\n    }\n\n    figure.insertBefore(toolbar, figure.firstChild);\n\n    toggleBtn.addEventListener(\"click\", function () {\n      const expanded = figure.classList.toggle(\"ncsg-code-expanded\");\n\n      if (expanded) {\n        setButtonIcon(toggleBtn, \"collapse\", \"collapse\");\n        toggleBtn.setAttribute(\"aria-expanded\", \"true\");\n      } else {\n        setButtonIcon(toggleBtn, \"expand\", \"expand\");\n        toggleBtn.setAttribute(\"aria-expanded\", \"false\");\n\n        /*\n         * 折叠回去后，把滚动位置重置到顶部。\n         * 如果你希望保留原滚动位置，可以删掉这两行。\n         */\n        scrollBox.scrollTop = 0;\n      }\n    });\n\n    copyBtn.addEventListener(\"click\", function () {\n      const code = getCodeText(figure);\n\n      if (!code) {\n        copyBtn.classList.add(\"ncsg-code-failed\");\n        setButtonIcon(copyBtn, \"failed\", \"failed\");\n\n        setTimeout(function () {\n          copyBtn.classList.remove(\"ncsg-code-failed\");\n          setButtonIcon(copyBtn, \"copy\", \"copy\");\n        }, 1200);\n\n        return;\n      }\n\n      copyText(code)\n        .then(function () {\n          copyBtn.classList.add(\"ncsg-code-copied\");\n          setButtonIcon(copyBtn, \"copied\", \"copied\");\n\n          setTimeout(function () {\n            copyBtn.classList.remove(\"ncsg-code-copied\");\n            setButtonIcon(copyBtn, \"copy\", \"copy\");\n          }, 1200);\n        })\n        .catch(function () {\n          copyBtn.classList.add(\"ncsg-code-failed\");\n          setButtonIcon(copyBtn, \"failed\", \"failed\");\n\n          setTimeout(function () {\n            copyBtn.classList.remove(\"ncsg-code-failed\");\n            setButtonIcon(copyBtn, \"copy\", \"copy\");\n          }, 1500);\n        });\n    });\n\n    /*\n     * 等浏览器完成布局后再判断是否需要展开按钮。\n     * 否则刚插入 DOM 时高度可能还没稳定。\n     */\n    requestAnimationFrame(function () {\n      updateToggleVisibility(figure, scrollBox, toggleBtn);\n    });\n\n    /*\n     * 字体加载完成后，高度可能变化，再判断一次。\n     */\n    if (document.fonts && document.fonts.ready) {\n      document.fonts.ready.then(function () {\n        updateToggleVisibility(figure, scrollBox, toggleBtn);\n      });\n    }\n\n    /*\n     * 窗口尺寸变化后重新判断。\n     */\n    let resizeTimer = null;\n\n    window.addEventListener(\"resize\", function () {\n      clearTimeout(resizeTimer);\n\n      resizeTimer = setTimeout(function () {\n        updateToggleVisibility(figure, scrollBox, toggleBtn);\n      }, 150);\n    });\n  }\n\n  function initCodeTools() {\n    const figures = document.querySelectorAll(\"figure.highlight\");\n\n    figures.forEach(function (figure) {\n      enhanceCodeBlock(figure);\n    });\n  }\n\n  if (document.readyState === \"loading\") {\n    document.addEventListener(\"DOMContentLoaded\", initCodeTools);\n  } else {\n    initCodeTools();\n  }\n})();"},{"title":"Research","math":true,"_content":"\n# Research\n\nThe NCSG Group focuses on numerical computation, satellite gravity, and geodetic data analysis.\n\n## Satellite Gravity and GRACE/GRACE-FO\n\nWe study time-variable gravity fields using satellite gravity missions such as GRACE and GRACE-FO. Our research includes gravity field recovery, signal separation, leakage correction, and applications to Earth system mass transport.\n\nKeywords: GRACE, GRACE-FO, time-variable gravity, spherical harmonics, mascon.\n\n## Numerical Methods for Inverse Problems\n\nWe develop numerical methods for large-scale geodetic inverse problems, including regularization, iterative solvers, uncertainty quantification, and computational optimization.\n\nKeywords: inverse problems, regularization, numerical linear algebra, optimization.\n\n## Earth System Mass Transport\n\nWe use satellite gravity and complementary observations to study terrestrial water storage, ice mass change, sea-level change, and other mass redistribution processes.\n\nKeywords: terrestrial water storage, ice sheets, hydrology, sea level, Earth system.\n\n## Open Science and Reproducible Research\n\nWe promote open-source tools, reproducible workflows, and public data products through GitHub, Zenodo, and related open science platforms.","source":"research/index.md","raw":"---\ntitle: Research\nmath: true\n---\n\n# Research\n\nThe NCSG Group focuses on numerical computation, satellite gravity, and geodetic data analysis.\n\n## Satellite Gravity and GRACE/GRACE-FO\n\nWe study time-variable gravity fields using satellite gravity missions such as GRACE and GRACE-FO. Our research includes gravity field recovery, signal separation, leakage correction, and applications to Earth system mass transport.\n\nKeywords: GRACE, GRACE-FO, time-variable gravity, spherical harmonics, mascon.\n\n## Numerical Methods for Inverse Problems\n\nWe develop numerical methods for large-scale geodetic inverse problems, including regularization, iterative solvers, uncertainty quantification, and computational optimization.\n\nKeywords: inverse problems, regularization, numerical linear algebra, optimization.\n\n## Earth System Mass Transport\n\nWe use satellite gravity and complementary observations to study terrestrial water storage, ice mass change, sea-level change, and other mass redistribution processes.\n\nKeywords: terrestrial water storage, ice sheets, hydrology, sea level, Earth system.\n\n## Open Science and Reproducible Research\n\nWe promote open-source tools, reproducible workflows, and public data products through GitHub, Zenodo, and related open science platforms.","date":"2026-07-30T02:18:50.970Z","updated":"2026-07-30T02:18:50.970Z","path":"research/index.html","comments":1,"layout":"page","_id":"cuidGq3Z27rQzXa9Ke6Oz0JLZ","content":"<h1 id=\"research\">Research</h1>\n<p>The NCSG Group focuses on numerical computation, satellite gravity, and geodetic data analysis.</p>\n<h2 id=\"Satellite-Gravity-and-GRACE-GRACE-FO\">Satellite Gravity and GRACE/GRACE-FO</h2>\n<p>We study time-variable gravity fields using satellite gravity missions such as GRACE and GRACE-FO. Our research includes gravity field recovery, signal separation, leakage correction, and applications to Earth system mass transport.</p>\n<p>Keywords: GRACE, GRACE-FO, time-variable gravity, spherical harmonics, mascon.</p>\n<h2 id=\"Numerical-Methods-for-Inverse-Problems\">Numerical Methods for Inverse Problems</h2>\n<p>We develop numerical methods for large-scale geodetic inverse problems, including regularization, iterative solvers, uncertainty quantification, and computational optimization.</p>\n<p>Keywords: inverse problems, regularization, numerical linear algebra, optimization.</p>\n<h2 id=\"Earth-System-Mass-Transport\">Earth System Mass Transport</h2>\n<p>We use satellite gravity and complementary observations to study terrestrial water storage, ice mass change, sea-level change, and other mass redistribution processes.</p>\n<p>Keywords: terrestrial water storage, ice sheets, hydrology, sea level, Earth system.</p>\n<h2 id=\"Open-Science-and-Reproducible-Research\">Open Science and Reproducible Research</h2>\n<p>We promote open-source tools, reproducible workflows, and public data products through GitHub, Zenodo, and related open science platforms.</p>\n","excerpt":"","more":"<h1>Research</h1>\n<p>The NCSG Group focuses on numerical computation, satellite gravity, and geodetic data analysis.</p>\n<h2 id=\"Satellite-Gravity-and-GRACE-GRACE-FO\">Satellite Gravity and GRACE/GRACE-FO</h2>\n<p>We study time-variable gravity fields using satellite gravity missions such as GRACE and GRACE-FO. Our research includes gravity field recovery, signal separation, leakage correction, and applications to Earth system mass transport.</p>\n<p>Keywords: GRACE, GRACE-FO, time-variable gravity, spherical harmonics, mascon.</p>\n<h2 id=\"Numerical-Methods-for-Inverse-Problems\">Numerical Methods for Inverse Problems</h2>\n<p>We develop numerical methods for large-scale geodetic inverse problems, including regularization, iterative solvers, uncertainty quantification, and computational optimization.</p>\n<p>Keywords: inverse problems, regularization, numerical linear algebra, optimization.</p>\n<h2 id=\"Earth-System-Mass-Transport\">Earth System Mass Transport</h2>\n<p>We use satellite gravity and complementary observations to study terrestrial water storage, ice mass change, sea-level change, and other mass redistribution processes.</p>\n<p>Keywords: terrestrial water storage, ice sheets, hydrology, sea level, Earth system.</p>\n<h2 id=\"Open-Science-and-Reproducible-Research\">Open Science and Reproducible Research</h2>\n<p>We promote open-source tools, reproducible workflows, and public data products through GitHub, Zenodo, and related open science platforms.</p>\n"},{"_content":"/* =========================================================\n * ncsg-content-merged.css\n *\n * For Hexo Fluid:\n * 1. Markdown table horizontal scroll\n * 2. Markdown table light/dark mode adaptation\n * 3. Code block horizontal scroll + line number gutter\n * 4. Prevent table styles from polluting Hexo highlight code tables\n * ========================================================= */\n\n\n/* =========================================================\n * 0. Theme variables\n * ========================================================= */\n\n:root {\n    /* ---------- Markdown table: light mode ---------- */\n    --ncsg-table-text: #2f3542;\n    --ncsg-table-bg: #ffffff;\n    --ncsg-table-head-bg: #f3f6fa;\n    --ncsg-table-stripe-bg: #fafbfc;\n    --ncsg-table-hover-bg: #f1f5f9;\n    --ncsg-table-border: rgba(80, 100, 120, 0.32);\n    --ncsg-table-scrollbar: rgba(100, 116, 139, 0.38);\n    --ncsg-table-scrollbar-hover: rgba(100, 116, 139, 0.6);\n\n    /* ---------- Code block: light mode ---------- */\n    --ncsg-code-bg: #ffffff;\n    --ncsg-code-gutter-bg: #f1f3f5;\n    --ncsg-code-gutter-text: #7a828c;\n    --ncsg-code-gutter-border: rgba(80, 95, 115, 0.18);\n}\n\n\n/* =========================================================\n * 0.1 Dark mode variables\n *\n * Compatible with Fluid and common dark-mode selectors.\n * ========================================================= */\n\nhtml[data-user-color-scheme=\"dark\"],\nbody[data-user-color-scheme=\"dark\"],\n[data-user-color-scheme=\"dark\"],\nhtml.dark,\nbody.dark,\nhtml[data-theme=\"dark\"],\nbody[data-theme=\"dark\"] {\n    /* ---------- Markdown table: dark mode ---------- */\n    --ncsg-table-text: #c9d1d9;\n    --ncsg-table-bg: #222832;\n    --ncsg-table-head-bg: #2d3542;\n    --ncsg-table-stripe-bg: #262e39;\n    --ncsg-table-hover-bg: #323c4a;\n    --ncsg-table-border: rgba(148, 163, 184, 0.35);\n    --ncsg-table-scrollbar: rgba(148, 163, 184, 0.42);\n    --ncsg-table-scrollbar-hover: rgba(148, 163, 184, 0.68);\n\n    /* ---------- Code block: dark mode ---------- */\n    --ncsg-code-bg: #282c34;\n    --ncsg-code-gutter-bg: #242932;\n    --ncsg-code-gutter-text: #9aa4b2;\n    --ncsg-code-gutter-border: rgba(255, 255, 255, 0.12);\n}\n\n\n/* ---------- Fallback: system dark mode ---------- */\n@media (prefers-color-scheme: dark) {\n    :root:not([data-user-color-scheme=\"light\"]) {\n        --ncsg-table-text: #c9d1d9;\n        --ncsg-table-bg: #222832;\n        --ncsg-table-head-bg: #2d3542;\n        --ncsg-table-stripe-bg: #262e39;\n        --ncsg-table-hover-bg: #323c4a;\n        --ncsg-table-border: rgba(148, 163, 184, 0.35);\n        --ncsg-table-scrollbar: rgba(148, 163, 184, 0.42);\n        --ncsg-table-scrollbar-hover: rgba(148, 163, 184, 0.68);\n\n        --ncsg-code-bg: #282c34;\n        --ncsg-code-gutter-bg: #242932;\n        --ncsg-code-gutter-text: #9aa4b2;\n        --ncsg-code-gutter-border: rgba(255, 255, 255, 0.12);\n    }\n}\n\n\n/* =========================================================\n * 1. Markdown table horizontal scroll\n *\n * Important:\n * Exclude Hexo highlight tables:\n *   figure.highlight table\n *\n * The previous bug was caused by broad selectors like:\n *   #board table\n * They also matched code-block internal tables.\n * ========================================================= */\n\n:where(.markdown-body, .post-content, .article-content, #board)\ntable:not(.highlight):not(figure.highlight table):not(.highlight table) {\n    display: block !important;\n\n    width: max-content !important;\n    max-width: 100% !important;\n\n    overflow-x: auto !important;\n    overflow-y: hidden !important;\n\n    margin: 1rem 0 !important;\n\n    border-collapse: collapse !important;\n    border-spacing: 0 !important;\n\n    color: var(--ncsg-table-text) !important;\n    background-color: var(--ncsg-table-bg) !important;\n\n    -webkit-overflow-scrolling: touch;\n}\n\n\n/* =========================================================\n * 2. Markdown table cell style\n * ========================================================= */\n\n:where(.markdown-body, .post-content, .article-content, #board)\ntable:not(.highlight):not(figure.highlight table):not(.highlight table)\n:is(th, td) {\n    padding: 0.45rem 0.75rem !important;\n\n    border: 1px solid var(--ncsg-table-border) !important;\n\n    line-height: 1.6 !important;\n    vertical-align: middle !important;\n\n    white-space: nowrap !important;\n\n    color: var(--ncsg-table-text) !important;\n    background-color: var(--ncsg-table-bg) !important;\n}\n\n\n/* =========================================================\n * 3. Markdown table header style\n * ========================================================= */\n\n:where(.markdown-body, .post-content, .article-content, #board)\ntable:not(.highlight):not(figure.highlight table):not(.highlight table)\nth {\n    font-weight: 700 !important;\n    text-align: center !important;\n\n    color: var(--ncsg-table-text) !important;\n    background-color: var(--ncsg-table-head-bg) !important;\n}\n\n\n/* =========================================================\n * 4. Markdown table body style\n * ========================================================= */\n\n:where(.markdown-body, .post-content, .article-content, #board)\ntable:not(.highlight):not(figure.highlight table):not(.highlight table)\ntd {\n    color: var(--ncsg-table-text) !important;\n    background-color: var(--ncsg-table-bg) !important;\n}\n\n\n/* =========================================================\n * 5. Markdown table zebra stripe\n * ========================================================= */\n\n:where(.markdown-body, .post-content, .article-content, #board)\ntable:not(.highlight):not(figure.highlight table):not(.highlight table)\ntbody tr:nth-child(even) td {\n    background-color: var(--ncsg-table-stripe-bg) !important;\n}\n\n\n/* =========================================================\n * 6. Markdown table hover effect\n * ========================================================= */\n\n:where(.markdown-body, .post-content, .article-content, #board)\ntable:not(.highlight):not(figure.highlight table):not(.highlight table)\ntbody tr:hover td {\n    background-color: var(--ncsg-table-hover-bg) !important;\n}\n\n\n/* =========================================================\n * 7. Markdown table scrollbar style\n * ========================================================= */\n\n:where(.markdown-body, .post-content, .article-content, #board)\ntable:not(.highlight):not(figure.highlight table):not(.highlight table)::-webkit-scrollbar {\n    height: 8px;\n}\n\n:where(.markdown-body, .post-content, .article-content, #board)\ntable:not(.highlight):not(figure.highlight table):not(.highlight table)::-webkit-scrollbar-track {\n    background: transparent;\n}\n\n:where(.markdown-body, .post-content, .article-content, #board)\ntable:not(.highlight):not(figure.highlight table):not(.highlight table)::-webkit-scrollbar-thumb {\n    background-color: var(--ncsg-table-scrollbar);\n    border-radius: 999px;\n}\n\n:where(.markdown-body, .post-content, .article-content, #board)\ntable:not(.highlight):not(figure.highlight table):not(.highlight table)::-webkit-scrollbar-thumb:hover {\n    background-color: var(--ncsg-table-scrollbar-hover);\n}\n\n\n/* =========================================================\n * 8. Code block scroll + line number gutter + toolbar\n * ========================================================= */\n\n/*\n * 说明：\n * 1. figure.highlight 本身不再承担滚动。\n * 2. JS 会把代码表格包进 .ncsg-code-scroll。\n * 3. .ncsg-code-scroll 负责横向 / 纵向滚动。\n * 4. 展开后取消 max-height，从而显示完整代码。\n */\n\nfigure.highlight {\n    --ncsg-code-font-family: \"JetBrains Mono\",\n    \"Fira Code\",\n    \"Cascadia Code\",\n    \"SFMono-Regular\",\n    Consolas,\n    \"Liberation Mono\",\n    Menlo,\n    Monaco,\n    monospace;\n\n    --ncsg-code-font-size: 0.92rem;\n    --ncsg-code-line-height: 1.65;\n    --ncsg-code-padding-y: 0.85rem;\n\n    /*\n     * 折叠状态下代码块最大高度。\n     * 可以按喜好改成 420px、520px、60vh 等。\n     */\n    --ncsg-code-collapsed-max-height: 520px;\n\n    margin: 1rem 0 !important;\n    padding: 0 !important;\n\n    background: var(--ncsg-code-bg) !important;\n    border-radius: 6px;\n\n    /*\n     * 重要：\n     * figure 本身不滚动，避免 toolbar 和代码一起滚动导致布局混乱。\n     */\n    overflow: hidden !important;\n\n    position: relative;\n}\n\n/* 工具栏 */\nfigure.highlight .ncsg-code-toolbar {\n  display: flex !important;\n  justify-content: space-between !important;\n  align-items: center !important;\n  gap: 0.75rem !important;\n\n  padding: 0.45rem 0.55rem !important;\n\n  background: var(--ncsg-code-bg) !important;\n  border-bottom: 1px solid var(--ncsg-code-gutter-border) !important;\n\n  user-select: none !important;\n}\n\n/* 左侧语言标签 */\nfigure.highlight .ncsg-code-lang {\n  display: inline-flex;\n  align-items: center;\n\n  min-width: 0;\n\n  padding-left: 0.25rem;\n\n  font-family:\n    \"JetBrains Mono\",\n    \"Fira Code\",\n    \"Cascadia Code\",\n    \"SFMono-Regular\",\n    Consolas,\n    \"Liberation Mono\",\n    Menlo,\n    Monaco,\n    monospace;\n\n  font-size: 0.78rem;\n  line-height: 1;\n\n  color: var(--ncsg-code-gutter-text);\n\n  opacity: 0.85;\n  white-space: nowrap;\n}\n\n/* 没识别到语言时隐藏 */\nfigure.highlight .ncsg-code-lang:empty {\n  display: none;\n}\n\n/* 右侧按钮容器 */\nfigure.highlight .ncsg-code-actions {\n  display: inline-flex;\n  align-items: center;\n  justify-content: flex-end;\n  gap: 0.45rem;\n\n  margin-left: auto;\n}\n\n/* 工具栏按钮 */\nfigure.highlight .ncsg-code-btn {\n  appearance: none;\n\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n\n  width: 1.75rem;\n  height: 1.75rem;\n\n  padding: 0;\n\n  border: 1px solid var(--ncsg-code-gutter-border);\n  border-radius: 4px;\n\n  cursor: pointer;\n\n  color: var(--ncsg-code-gutter-text);\n  background: transparent;\n\n  transition:\n    background-color 0.15s ease,\n    color 0.15s ease,\n    border-color 0.15s ease,\n    opacity 0.15s ease;\n}\n\nfigure.highlight .ncsg-code-btn:hover {\n  color: inherit;\n  background: rgba(127, 127, 127, 0.12);\n}\n\nfigure.highlight .ncsg-code-btn svg {\n  width: 1rem;\n  height: 1rem;\n\n  display: block;\n\n  stroke: currentColor;\n  fill: none;\n  stroke-width: 2;\n  stroke-linecap: round;\n  stroke-linejoin: round;\n\n  pointer-events: none;\n}\n\n/* 不需要展开时隐藏展开按钮 */\nfigure.highlight .ncsg-code-toggle.ncsg-code-toggle-hidden {\n  display: none !important;\n}\n\n/* 复制成功/失败时的轻微状态提示 */\nfigure.highlight .ncsg-code-btn.ncsg-code-copied {\n  color: #22c55e;\n  border-color: rgba(34, 197, 94, 0.55);\n}\n\nfigure.highlight .ncsg-code-btn.ncsg-code-failed {\n  color: #ef4444;\n  border-color: rgba(239, 68, 68, 0.55);\n}\n\n/*\n * JS 创建的滚动容器。\n * 折叠状态：\n * - 横向滚动：保留\n * - 纵向滚动：超过最大高度才出现\n */\nfigure.highlight .ncsg-code-scroll {\n    max-height: var(--ncsg-code-collapsed-max-height);\n\n    overflow-x: auto !important;\n    overflow-y: auto !important;\n\n    background: var(--ncsg-code-bg) !important;\n\n    -webkit-overflow-scrolling: touch;\n}\n\n/*\n * 展开状态：\n * - 不限制高度\n * - 不再纵向滚动\n * - 横向滚动仍然保留\n */\nfigure.highlight.ncsg-code-expanded .ncsg-code-scroll {\n    max-height: none !important;\n\n    overflow-x: auto !important;\n    overflow-y: visible !important;\n}\n\n/*\n * 如果 JS 还没执行，figure.highlight 下面可能直接是 table。\n * 这个 fallback 保证没有 JS 时仍然能横向滚动。\n */\nfigure.highlight:not(.ncsg-code-enhanced) {\n    overflow-x: auto !important;\n    overflow-y: auto !important;\n    max-height: var(--ncsg-code-collapsed-max-height);\n}\n\n/* Reset internal highlight table */\nfigure.highlight table {\n    display: table !important;\n\n    width: max-content !important;\n    min-width: 100% !important;\n    max-width: none !important;\n\n    margin: 0 !important;\n    padding: 0 !important;\n\n    border-collapse: collapse !important;\n    border-spacing: 0 !important;\n    table-layout: auto !important;\n\n    overflow: visible !important;\n\n    color: inherit !important;\n    background: var(--ncsg-code-bg) !important;\n}\n\n/* 防止 Markdown 表格样式污染代码块内部表格 */\nfigure.highlight table,\nfigure.highlight thead,\nfigure.highlight tbody,\nfigure.highlight tr,\nfigure.highlight th,\nfigure.highlight td {\n    margin: 0 !important;\n    border: 0 !important;\n    background-color: transparent !important;\n}\n\n/*\n * 所有代码块单元格。\n * 注意：td 本身不要放上下 padding。\n * 上下 padding 统一放到 gutter pre 和 code pre 上。\n */\nfigure.highlight td {\n    padding: 0 !important;\n    vertical-align: top !important;\n\n    font-family: var(--ncsg-code-font-family) !important;\n    font-size: var(--ncsg-code-font-size) !important;\n    line-height: var(--ncsg-code-line-height) !important;\n}\n\n/* 行号区域 */\nfigure.highlight td.gutter {\n    position: sticky;\n    left: 0;\n    z-index: 3;\n\n    width: 3.5em;\n    min-width: 3.5em;\n    max-width: 3.5em;\n\n    user-select: none;\n    text-align: right;\n\n    color: var(--ncsg-code-gutter-text) !important;\n    background: var(--ncsg-code-gutter-bg) !important;\n    border-right: 1px solid var(--ncsg-code-gutter-border) !important;\n}\n\n/* 代码区域 */\nfigure.highlight td.code {\n    color: inherit !important;\n    background: var(--ncsg-code-bg) !important;\n}\n\n/*\n * 最关键的对齐规则：\n * gutter pre 和 code pre 的这些属性必须完全一致：\n * margin\n * padding-top\n * padding-bottom\n * font-family\n * font-size\n * line-height\n */\nfigure.highlight td.gutter pre,\nfigure.highlight td.code pre {\n    margin: 0 !important;\n\n    padding-top: var(--ncsg-code-padding-y) !important;\n    padding-bottom: var(--ncsg-code-padding-y) !important;\n\n    font-family: var(--ncsg-code-font-family) !important;\n    font-size: var(--ncsg-code-font-size) !important;\n    line-height: var(--ncsg-code-line-height) !important;\n\n    white-space: pre !important;\n    overflow: visible !important;\n\n    background: transparent !important;\n}\n\n/* 行号区只设置左右 padding */\nfigure.highlight td.gutter pre {\n    padding-left: 0.8rem !important;\n    padding-right: 0.75rem !important;\n\n    color: var(--ncsg-code-gutter-text) !important;\n    text-align: right !important;\n}\n\n/* 代码区只设置左右 padding */\nfigure.highlight td.code pre {\n    padding-left: 0.9rem !important;\n    padding-right: 1rem !important;\n\n    color: inherit !important;\n}\n\n/*\n * 重点修复：\n * 很多主题或 highlight.js 会给 pre code / .hljs 加 padding。\n * 这正是“代码内容整体下移半行”的常见原因。\n */\nfigure.highlight td.code pre code,\nfigure.highlight td.code pre .hljs,\nfigure.highlight td.code pre > code,\nfigure.highlight td.code pre > .hljs {\n    display: inline !important;\n\n    margin: 0 !important;\n    padding: 0 !important;\n\n    border: 0 !important;\n\n    font-family: inherit !important;\n    font-size: inherit !important;\n    line-height: inherit !important;\n\n    vertical-align: baseline !important;\n\n    background: transparent !important;\n}\n\n/*\n * 不强制 .line display:block。\n *\n * Hexo 默认 highlight 输出通常是：\n *\n * <span class=\"line\">...</span><br>\n *\n * 如果再强制 .line { display:block; }，会导致每行后面额外叠加 br，\n * 从而行距翻倍或明显错位。\n */\nfigure.highlight .line {\n    display: inline !important;\n\n    margin: 0 !important;\n    padding: 0 !important;\n\n    font-family: inherit !important;\n    font-size: inherit !important;\n    line-height: inherit !important;\n\n    vertical-align: baseline !important;\n\n    background: transparent !important;\n}\n\n/* token span 也统一继承，避免某些 token 改变 line-height */\nfigure.highlight span,\nfigure.highlight code,\nfigure.highlight pre code {\n    font-family: inherit !important;\n    font-size: inherit !important;\n    line-height: inherit !important;\n\n    background: transparent !important;\n}\n\n/* 行号颜色 */\nfigure.highlight td.gutter,\nfigure.highlight td.gutter pre,\nfigure.highlight td.gutter .line,\nfigure.highlight td.gutter span {\n    color: var(--ncsg-code-gutter-text) !important;\n}\n\n/*\n * 滚动条：\n * 因为现在滚动发生在 .ncsg-code-scroll 上，所以 scrollbar 放这里。\n */\nfigure.highlight .ncsg-code-scroll::-webkit-scrollbar {\n    width: 8px;\n    height: 8px;\n}\n\nfigure.highlight .ncsg-code-scroll::-webkit-scrollbar-track {\n    background: transparent;\n}\n\nfigure.highlight .ncsg-code-scroll::-webkit-scrollbar-thumb {\n    background-color: var(--ncsg-table-scrollbar);\n    border-radius: 999px;\n}\n\nfigure.highlight .ncsg-code-scroll::-webkit-scrollbar-thumb:hover {\n    background-color: var(--ncsg-table-scrollbar-hover);\n}\n\n/* Firefox scrollbar */\nfigure.highlight .ncsg-code-scroll {\n    scrollbar-width: thin;\n    scrollbar-color: var(--ncsg-table-scrollbar) transparent;\n}\n\n/* 移动端适配 */\n@media (max-width: 768px) {\n    figure.highlight {\n        --ncsg-code-font-size: 0.86rem;\n        --ncsg-code-line-height: 1.6;\n        --ncsg-code-collapsed-max-height: 420px;\n    }\n\n    figure.highlight td.gutter {\n        width: 3em;\n        min-width: 3em;\n        max-width: 3em;\n    }\n\n    figure.highlight .ncsg-code-toolbar {\n        padding: 0.4rem 0.45rem;\n    }\n\n    figure.highlight .ncsg-code-btn {\n        font-size: 0.74rem;\n    }\n}\n\n\n/* =========================================================\n * 9. Mobile optimization\n * ========================================================= */\n\n@media (max-width: 768px) {\n    :where(.markdown-body, .post-content, .article-content, #board)\n    table:not(.highlight):not(figure.highlight table):not(.highlight table) {\n        max-width: 100% !important;\n    }\n\n    :where(.markdown-body, .post-content, .article-content, #board)\n    table:not(.highlight):not(figure.highlight table):not(.highlight table)\n    :is(th, td) {\n        padding: 0.4rem 0.65rem !important;\n        font-size: 0.92rem !important;\n    }\n\n    figure.highlight td.gutter {\n        width: 3em;\n        min-width: 3em;\n        max-width: 3em;\n    }\n}\n\n/* =========================================================\n * 10. MathJax compatibility\n *\n * Prevent visual duplication caused by visible assistive MathML\n * and improve display formula overflow behavior.\n * ========================================================= */\n\n/* Display formulas: allow horizontal scroll when too long */\nmjx-container[display=\"true\"] {\n    display: block;\n    max-width: 100%;\n    overflow-x: auto;\n    overflow-y: hidden;\n    margin: 1em 0;\n    color: inherit;\n}\n\n/* Inline formulas: keep natural inline behavior */\nmjx-container:not([display=\"true\"]) {\n    color: inherit;\n}\n\n/* SVG output fallback, harmless for CHTML output */\nmjx-container svg {\n    max-width: none;\n}\n\n/* If MathJax assistive MathML becomes visible because of CSS reset,\n * force it to be visually hidden again.\n */\nmjx-assistive-mml {\n    position: absolute !important;\n    top: 0;\n    left: 0;\n\n    width: 1px !important;\n    height: 1px !important;\n\n    padding: 0 !important;\n    border: 0 !important;\n    margin: 0 !important;\n\n    overflow: hidden !important;\n    clip: rect(1px, 1px, 1px, 1px) !important;\n    white-space: nowrap !important;\n}","source":"css/ncsg-content-merged.css","raw":"/* =========================================================\n * ncsg-content-merged.css\n *\n * For Hexo Fluid:\n * 1. Markdown table horizontal scroll\n * 2. Markdown table light/dark mode adaptation\n * 3. Code block horizontal scroll + line number gutter\n * 4. Prevent table styles from polluting Hexo highlight code tables\n * ========================================================= */\n\n\n/* =========================================================\n * 0. Theme variables\n * ========================================================= */\n\n:root {\n    /* ---------- Markdown table: light mode ---------- */\n    --ncsg-table-text: #2f3542;\n    --ncsg-table-bg: #ffffff;\n    --ncsg-table-head-bg: #f3f6fa;\n    --ncsg-table-stripe-bg: #fafbfc;\n    --ncsg-table-hover-bg: #f1f5f9;\n    --ncsg-table-border: rgba(80, 100, 120, 0.32);\n    --ncsg-table-scrollbar: rgba(100, 116, 139, 0.38);\n    --ncsg-table-scrollbar-hover: rgba(100, 116, 139, 0.6);\n\n    /* ---------- Code block: light mode ---------- */\n    --ncsg-code-bg: #ffffff;\n    --ncsg-code-gutter-bg: #f1f3f5;\n    --ncsg-code-gutter-text: #7a828c;\n    --ncsg-code-gutter-border: rgba(80, 95, 115, 0.18);\n}\n\n\n/* =========================================================\n * 0.1 Dark mode variables\n *\n * Compatible with Fluid and common dark-mode selectors.\n * ========================================================= */\n\nhtml[data-user-color-scheme=\"dark\"],\nbody[data-user-color-scheme=\"dark\"],\n[data-user-color-scheme=\"dark\"],\nhtml.dark,\nbody.dark,\nhtml[data-theme=\"dark\"],\nbody[data-theme=\"dark\"] {\n    /* ---------- Markdown table: dark mode ---------- */\n    --ncsg-table-text: #c9d1d9;\n    --ncsg-table-bg: #222832;\n    --ncsg-table-head-bg: #2d3542;\n    --ncsg-table-stripe-bg: #262e39;\n    --ncsg-table-hover-bg: #323c4a;\n    --ncsg-table-border: rgba(148, 163, 184, 0.35);\n    --ncsg-table-scrollbar: rgba(148, 163, 184, 0.42);\n    --ncsg-table-scrollbar-hover: rgba(148, 163, 184, 0.68);\n\n    /* ---------- Code block: dark mode ---------- */\n    --ncsg-code-bg: #282c34;\n    --ncsg-code-gutter-bg: #242932;\n    --ncsg-code-gutter-text: #9aa4b2;\n    --ncsg-code-gutter-border: rgba(255, 255, 255, 0.12);\n}\n\n\n/* ---------- Fallback: system dark mode ---------- */\n@media (prefers-color-scheme: dark) {\n    :root:not([data-user-color-scheme=\"light\"]) {\n        --ncsg-table-text: #c9d1d9;\n        --ncsg-table-bg: #222832;\n        --ncsg-table-head-bg: #2d3542;\n        --ncsg-table-stripe-bg: #262e39;\n        --ncsg-table-hover-bg: #323c4a;\n        --ncsg-table-border: rgba(148, 163, 184, 0.35);\n        --ncsg-table-scrollbar: rgba(148, 163, 184, 0.42);\n        --ncsg-table-scrollbar-hover: rgba(148, 163, 184, 0.68);\n\n        --ncsg-code-bg: #282c34;\n        --ncsg-code-gutter-bg: #242932;\n        --ncsg-code-gutter-text: #9aa4b2;\n        --ncsg-code-gutter-border: rgba(255, 255, 255, 0.12);\n    }\n}\n\n\n/* =========================================================\n * 1. Markdown table horizontal scroll\n *\n * Important:\n * Exclude Hexo highlight tables:\n *   figure.highlight table\n *\n * The previous bug was caused by broad selectors like:\n *   #board table\n * They also matched code-block internal tables.\n * ========================================================= */\n\n:where(.markdown-body, .post-content, .article-content, #board)\ntable:not(.highlight):not(figure.highlight table):not(.highlight table) {\n    display: block !important;\n\n    width: max-content !important;\n    max-width: 100% !important;\n\n    overflow-x: auto !important;\n    overflow-y: hidden !important;\n\n    margin: 1rem 0 !important;\n\n    border-collapse: collapse !important;\n    border-spacing: 0 !important;\n\n    color: var(--ncsg-table-text) !important;\n    background-color: var(--ncsg-table-bg) !important;\n\n    -webkit-overflow-scrolling: touch;\n}\n\n\n/* =========================================================\n * 2. Markdown table cell style\n * ========================================================= */\n\n:where(.markdown-body, .post-content, .article-content, #board)\ntable:not(.highlight):not(figure.highlight table):not(.highlight table)\n:is(th, td) {\n    padding: 0.45rem 0.75rem !important;\n\n    border: 1px solid var(--ncsg-table-border) !important;\n\n    line-height: 1.6 !important;\n    vertical-align: middle !important;\n\n    white-space: nowrap !important;\n\n    color: var(--ncsg-table-text) !important;\n    background-color: var(--ncsg-table-bg) !important;\n}\n\n\n/* =========================================================\n * 3. Markdown table header style\n * ========================================================= */\n\n:where(.markdown-body, .post-content, .article-content, #board)\ntable:not(.highlight):not(figure.highlight table):not(.highlight table)\nth {\n    font-weight: 700 !important;\n    text-align: center !important;\n\n    color: var(--ncsg-table-text) !important;\n    background-color: var(--ncsg-table-head-bg) !important;\n}\n\n\n/* =========================================================\n * 4. Markdown table body style\n * ========================================================= */\n\n:where(.markdown-body, .post-content, .article-content, #board)\ntable:not(.highlight):not(figure.highlight table):not(.highlight table)\ntd {\n    color: var(--ncsg-table-text) !important;\n    background-color: var(--ncsg-table-bg) !important;\n}\n\n\n/* =========================================================\n * 5. Markdown table zebra stripe\n * ========================================================= */\n\n:where(.markdown-body, .post-content, .article-content, #board)\ntable:not(.highlight):not(figure.highlight table):not(.highlight table)\ntbody tr:nth-child(even) td {\n    background-color: var(--ncsg-table-stripe-bg) !important;\n}\n\n\n/* =========================================================\n * 6. Markdown table hover effect\n * ========================================================= */\n\n:where(.markdown-body, .post-content, .article-content, #board)\ntable:not(.highlight):not(figure.highlight table):not(.highlight table)\ntbody tr:hover td {\n    background-color: var(--ncsg-table-hover-bg) !important;\n}\n\n\n/* =========================================================\n * 7. Markdown table scrollbar style\n * ========================================================= */\n\n:where(.markdown-body, .post-content, .article-content, #board)\ntable:not(.highlight):not(figure.highlight table):not(.highlight table)::-webkit-scrollbar {\n    height: 8px;\n}\n\n:where(.markdown-body, .post-content, .article-content, #board)\ntable:not(.highlight):not(figure.highlight table):not(.highlight table)::-webkit-scrollbar-track {\n    background: transparent;\n}\n\n:where(.markdown-body, .post-content, .article-content, #board)\ntable:not(.highlight):not(figure.highlight table):not(.highlight table)::-webkit-scrollbar-thumb {\n    background-color: var(--ncsg-table-scrollbar);\n    border-radius: 999px;\n}\n\n:where(.markdown-body, .post-content, .article-content, #board)\ntable:not(.highlight):not(figure.highlight table):not(.highlight table)::-webkit-scrollbar-thumb:hover {\n    background-color: var(--ncsg-table-scrollbar-hover);\n}\n\n\n/* =========================================================\n * 8. Code block scroll + line number gutter + toolbar\n * ========================================================= */\n\n/*\n * 说明：\n * 1. figure.highlight 本身不再承担滚动。\n * 2. JS 会把代码表格包进 .ncsg-code-scroll。\n * 3. .ncsg-code-scroll 负责横向 / 纵向滚动。\n * 4. 展开后取消 max-height，从而显示完整代码。\n */\n\nfigure.highlight {\n    --ncsg-code-font-family: \"JetBrains Mono\",\n    \"Fira Code\",\n    \"Cascadia Code\",\n    \"SFMono-Regular\",\n    Consolas,\n    \"Liberation Mono\",\n    Menlo,\n    Monaco,\n    monospace;\n\n    --ncsg-code-font-size: 0.92rem;\n    --ncsg-code-line-height: 1.65;\n    --ncsg-code-padding-y: 0.85rem;\n\n    /*\n     * 折叠状态下代码块最大高度。\n     * 可以按喜好改成 420px、520px、60vh 等。\n     */\n    --ncsg-code-collapsed-max-height: 520px;\n\n    margin: 1rem 0 !important;\n    padding: 0 !important;\n\n    background: var(--ncsg-code-bg) !important;\n    border-radius: 6px;\n\n    /*\n     * 重要：\n     * figure 本身不滚动，避免 toolbar 和代码一起滚动导致布局混乱。\n     */\n    overflow: hidden !important;\n\n    position: relative;\n}\n\n/* 工具栏 */\nfigure.highlight .ncsg-code-toolbar {\n  display: flex !important;\n  justify-content: space-between !important;\n  align-items: center !important;\n  gap: 0.75rem !important;\n\n  padding: 0.45rem 0.55rem !important;\n\n  background: var(--ncsg-code-bg) !important;\n  border-bottom: 1px solid var(--ncsg-code-gutter-border) !important;\n\n  user-select: none !important;\n}\n\n/* 左侧语言标签 */\nfigure.highlight .ncsg-code-lang {\n  display: inline-flex;\n  align-items: center;\n\n  min-width: 0;\n\n  padding-left: 0.25rem;\n\n  font-family:\n    \"JetBrains Mono\",\n    \"Fira Code\",\n    \"Cascadia Code\",\n    \"SFMono-Regular\",\n    Consolas,\n    \"Liberation Mono\",\n    Menlo,\n    Monaco,\n    monospace;\n\n  font-size: 0.78rem;\n  line-height: 1;\n\n  color: var(--ncsg-code-gutter-text);\n\n  opacity: 0.85;\n  white-space: nowrap;\n}\n\n/* 没识别到语言时隐藏 */\nfigure.highlight .ncsg-code-lang:empty {\n  display: none;\n}\n\n/* 右侧按钮容器 */\nfigure.highlight .ncsg-code-actions {\n  display: inline-flex;\n  align-items: center;\n  justify-content: flex-end;\n  gap: 0.45rem;\n\n  margin-left: auto;\n}\n\n/* 工具栏按钮 */\nfigure.highlight .ncsg-code-btn {\n  appearance: none;\n\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n\n  width: 1.75rem;\n  height: 1.75rem;\n\n  padding: 0;\n\n  border: 1px solid var(--ncsg-code-gutter-border);\n  border-radius: 4px;\n\n  cursor: pointer;\n\n  color: var(--ncsg-code-gutter-text);\n  background: transparent;\n\n  transition:\n    background-color 0.15s ease,\n    color 0.15s ease,\n    border-color 0.15s ease,\n    opacity 0.15s ease;\n}\n\nfigure.highlight .ncsg-code-btn:hover {\n  color: inherit;\n  background: rgba(127, 127, 127, 0.12);\n}\n\nfigure.highlight .ncsg-code-btn svg {\n  width: 1rem;\n  height: 1rem;\n\n  display: block;\n\n  stroke: currentColor;\n  fill: none;\n  stroke-width: 2;\n  stroke-linecap: round;\n  stroke-linejoin: round;\n\n  pointer-events: none;\n}\n\n/* 不需要展开时隐藏展开按钮 */\nfigure.highlight .ncsg-code-toggle.ncsg-code-toggle-hidden {\n  display: none !important;\n}\n\n/* 复制成功/失败时的轻微状态提示 */\nfigure.highlight .ncsg-code-btn.ncsg-code-copied {\n  color: #22c55e;\n  border-color: rgba(34, 197, 94, 0.55);\n}\n\nfigure.highlight .ncsg-code-btn.ncsg-code-failed {\n  color: #ef4444;\n  border-color: rgba(239, 68, 68, 0.55);\n}\n\n/*\n * JS 创建的滚动容器。\n * 折叠状态：\n * - 横向滚动：保留\n * - 纵向滚动：超过最大高度才出现\n */\nfigure.highlight .ncsg-code-scroll {\n    max-height: var(--ncsg-code-collapsed-max-height);\n\n    overflow-x: auto !important;\n    overflow-y: auto !important;\n\n    background: var(--ncsg-code-bg) !important;\n\n    -webkit-overflow-scrolling: touch;\n}\n\n/*\n * 展开状态：\n * - 不限制高度\n * - 不再纵向滚动\n * - 横向滚动仍然保留\n */\nfigure.highlight.ncsg-code-expanded .ncsg-code-scroll {\n    max-height: none !important;\n\n    overflow-x: auto !important;\n    overflow-y: visible !important;\n}\n\n/*\n * 如果 JS 还没执行，figure.highlight 下面可能直接是 table。\n * 这个 fallback 保证没有 JS 时仍然能横向滚动。\n */\nfigure.highlight:not(.ncsg-code-enhanced) {\n    overflow-x: auto !important;\n    overflow-y: auto !important;\n    max-height: var(--ncsg-code-collapsed-max-height);\n}\n\n/* Reset internal highlight table */\nfigure.highlight table {\n    display: table !important;\n\n    width: max-content !important;\n    min-width: 100% !important;\n    max-width: none !important;\n\n    margin: 0 !important;\n    padding: 0 !important;\n\n    border-collapse: collapse !important;\n    border-spacing: 0 !important;\n    table-layout: auto !important;\n\n    overflow: visible !important;\n\n    color: inherit !important;\n    background: var(--ncsg-code-bg) !important;\n}\n\n/* 防止 Markdown 表格样式污染代码块内部表格 */\nfigure.highlight table,\nfigure.highlight thead,\nfigure.highlight tbody,\nfigure.highlight tr,\nfigure.highlight th,\nfigure.highlight td {\n    margin: 0 !important;\n    border: 0 !important;\n    background-color: transparent !important;\n}\n\n/*\n * 所有代码块单元格。\n * 注意：td 本身不要放上下 padding。\n * 上下 padding 统一放到 gutter pre 和 code pre 上。\n */\nfigure.highlight td {\n    padding: 0 !important;\n    vertical-align: top !important;\n\n    font-family: var(--ncsg-code-font-family) !important;\n    font-size: var(--ncsg-code-font-size) !important;\n    line-height: var(--ncsg-code-line-height) !important;\n}\n\n/* 行号区域 */\nfigure.highlight td.gutter {\n    position: sticky;\n    left: 0;\n    z-index: 3;\n\n    width: 3.5em;\n    min-width: 3.5em;\n    max-width: 3.5em;\n\n    user-select: none;\n    text-align: right;\n\n    color: var(--ncsg-code-gutter-text) !important;\n    background: var(--ncsg-code-gutter-bg) !important;\n    border-right: 1px solid var(--ncsg-code-gutter-border) !important;\n}\n\n/* 代码区域 */\nfigure.highlight td.code {\n    color: inherit !important;\n    background: var(--ncsg-code-bg) !important;\n}\n\n/*\n * 最关键的对齐规则：\n * gutter pre 和 code pre 的这些属性必须完全一致：\n * margin\n * padding-top\n * padding-bottom\n * font-family\n * font-size\n * line-height\n */\nfigure.highlight td.gutter pre,\nfigure.highlight td.code pre {\n    margin: 0 !important;\n\n    padding-top: var(--ncsg-code-padding-y) !important;\n    padding-bottom: var(--ncsg-code-padding-y) !important;\n\n    font-family: var(--ncsg-code-font-family) !important;\n    font-size: var(--ncsg-code-font-size) !important;\n    line-height: var(--ncsg-code-line-height) !important;\n\n    white-space: pre !important;\n    overflow: visible !important;\n\n    background: transparent !important;\n}\n\n/* 行号区只设置左右 padding */\nfigure.highlight td.gutter pre {\n    padding-left: 0.8rem !important;\n    padding-right: 0.75rem !important;\n\n    color: var(--ncsg-code-gutter-text) !important;\n    text-align: right !important;\n}\n\n/* 代码区只设置左右 padding */\nfigure.highlight td.code pre {\n    padding-left: 0.9rem !important;\n    padding-right: 1rem !important;\n\n    color: inherit !important;\n}\n\n/*\n * 重点修复：\n * 很多主题或 highlight.js 会给 pre code / .hljs 加 padding。\n * 这正是“代码内容整体下移半行”的常见原因。\n */\nfigure.highlight td.code pre code,\nfigure.highlight td.code pre .hljs,\nfigure.highlight td.code pre > code,\nfigure.highlight td.code pre > .hljs {\n    display: inline !important;\n\n    margin: 0 !important;\n    padding: 0 !important;\n\n    border: 0 !important;\n\n    font-family: inherit !important;\n    font-size: inherit !important;\n    line-height: inherit !important;\n\n    vertical-align: baseline !important;\n\n    background: transparent !important;\n}\n\n/*\n * 不强制 .line display:block。\n *\n * Hexo 默认 highlight 输出通常是：\n *\n * <span class=\"line\">...</span><br>\n *\n * 如果再强制 .line { display:block; }，会导致每行后面额外叠加 br，\n * 从而行距翻倍或明显错位。\n */\nfigure.highlight .line {\n    display: inline !important;\n\n    margin: 0 !important;\n    padding: 0 !important;\n\n    font-family: inherit !important;\n    font-size: inherit !important;\n    line-height: inherit !important;\n\n    vertical-align: baseline !important;\n\n    background: transparent !important;\n}\n\n/* token span 也统一继承，避免某些 token 改变 line-height */\nfigure.highlight span,\nfigure.highlight code,\nfigure.highlight pre code {\n    font-family: inherit !important;\n    font-size: inherit !important;\n    line-height: inherit !important;\n\n    background: transparent !important;\n}\n\n/* 行号颜色 */\nfigure.highlight td.gutter,\nfigure.highlight td.gutter pre,\nfigure.highlight td.gutter .line,\nfigure.highlight td.gutter span {\n    color: var(--ncsg-code-gutter-text) !important;\n}\n\n/*\n * 滚动条：\n * 因为现在滚动发生在 .ncsg-code-scroll 上，所以 scrollbar 放这里。\n */\nfigure.highlight .ncsg-code-scroll::-webkit-scrollbar {\n    width: 8px;\n    height: 8px;\n}\n\nfigure.highlight .ncsg-code-scroll::-webkit-scrollbar-track {\n    background: transparent;\n}\n\nfigure.highlight .ncsg-code-scroll::-webkit-scrollbar-thumb {\n    background-color: var(--ncsg-table-scrollbar);\n    border-radius: 999px;\n}\n\nfigure.highlight .ncsg-code-scroll::-webkit-scrollbar-thumb:hover {\n    background-color: var(--ncsg-table-scrollbar-hover);\n}\n\n/* Firefox scrollbar */\nfigure.highlight .ncsg-code-scroll {\n    scrollbar-width: thin;\n    scrollbar-color: var(--ncsg-table-scrollbar) transparent;\n}\n\n/* 移动端适配 */\n@media (max-width: 768px) {\n    figure.highlight {\n        --ncsg-code-font-size: 0.86rem;\n        --ncsg-code-line-height: 1.6;\n        --ncsg-code-collapsed-max-height: 420px;\n    }\n\n    figure.highlight td.gutter {\n        width: 3em;\n        min-width: 3em;\n        max-width: 3em;\n    }\n\n    figure.highlight .ncsg-code-toolbar {\n        padding: 0.4rem 0.45rem;\n    }\n\n    figure.highlight .ncsg-code-btn {\n        font-size: 0.74rem;\n    }\n}\n\n\n/* =========================================================\n * 9. Mobile optimization\n * ========================================================= */\n\n@media (max-width: 768px) {\n    :where(.markdown-body, .post-content, .article-content, #board)\n    table:not(.highlight):not(figure.highlight table):not(.highlight table) {\n        max-width: 100% !important;\n    }\n\n    :where(.markdown-body, .post-content, .article-content, #board)\n    table:not(.highlight):not(figure.highlight table):not(.highlight table)\n    :is(th, td) {\n        padding: 0.4rem 0.65rem !important;\n        font-size: 0.92rem !important;\n    }\n\n    figure.highlight td.gutter {\n        width: 3em;\n        min-width: 3em;\n        max-width: 3em;\n    }\n}\n\n/* =========================================================\n * 10. MathJax compatibility\n *\n * Prevent visual duplication caused by visible assistive MathML\n * and improve display formula overflow behavior.\n * ========================================================= */\n\n/* Display formulas: allow horizontal scroll when too long */\nmjx-container[display=\"true\"] {\n    display: block;\n    max-width: 100%;\n    overflow-x: auto;\n    overflow-y: hidden;\n    margin: 1em 0;\n    color: inherit;\n}\n\n/* Inline formulas: keep natural inline behavior */\nmjx-container:not([display=\"true\"]) {\n    color: inherit;\n}\n\n/* SVG output fallback, harmless for CHTML output */\nmjx-container svg {\n    max-width: none;\n}\n\n/* If MathJax assistive MathML becomes visible because of CSS reset,\n * force it to be visually hidden again.\n */\nmjx-assistive-mml {\n    position: absolute !important;\n    top: 0;\n    left: 0;\n\n    width: 1px !important;\n    height: 1px !important;\n\n    padding: 0 !important;\n    border: 0 !important;\n    margin: 0 !important;\n\n    overflow: hidden !important;\n    clip: rect(1px, 1px, 1px, 1px) !important;\n    white-space: nowrap !important;\n}","date":"2026-07-31T03:29:06.359Z","updated":"2026-07-31T03:29:06.359Z","path":"css/ncsg-content-merged.css","layout":"false","title":"","comments":1,"_id":"cuidoxycDJYGjJodYLjcOy7Ph","content":"/* =========================================================\n * ncsg-content-merged.css\n *\n * For Hexo Fluid:\n * 1. Markdown table horizontal scroll\n * 2. Markdown table light/dark mode adaptation\n * 3. Code block horizontal scroll + line number gutter\n * 4. Prevent table styles from polluting Hexo highlight code tables\n * ========================================================= */\n\n\n/* =========================================================\n * 0. Theme variables\n * ========================================================= */\n\n:root {\n    /* ---------- Markdown table: light mode ---------- */\n    --ncsg-table-text: #2f3542;\n    --ncsg-table-bg: #ffffff;\n    --ncsg-table-head-bg: #f3f6fa;\n    --ncsg-table-stripe-bg: #fafbfc;\n    --ncsg-table-hover-bg: #f1f5f9;\n    --ncsg-table-border: rgba(80, 100, 120, 0.32);\n    --ncsg-table-scrollbar: rgba(100, 116, 139, 0.38);\n    --ncsg-table-scrollbar-hover: rgba(100, 116, 139, 0.6);\n\n    /* ---------- Code block: light mode ---------- */\n    --ncsg-code-bg: #ffffff;\n    --ncsg-code-gutter-bg: #f1f3f5;\n    --ncsg-code-gutter-text: #7a828c;\n    --ncsg-code-gutter-border: rgba(80, 95, 115, 0.18);\n}\n\n\n/* =========================================================\n * 0.1 Dark mode variables\n *\n * Compatible with Fluid and common dark-mode selectors.\n * ========================================================= */\n\nhtml[data-user-color-scheme=\"dark\"],\nbody[data-user-color-scheme=\"dark\"],\n[data-user-color-scheme=\"dark\"],\nhtml.dark,\nbody.dark,\nhtml[data-theme=\"dark\"],\nbody[data-theme=\"dark\"] {\n    /* ---------- Markdown table: dark mode ---------- */\n    --ncsg-table-text: #c9d1d9;\n    --ncsg-table-bg: #222832;\n    --ncsg-table-head-bg: #2d3542;\n    --ncsg-table-stripe-bg: #262e39;\n    --ncsg-table-hover-bg: #323c4a;\n    --ncsg-table-border: rgba(148, 163, 184, 0.35);\n    --ncsg-table-scrollbar: rgba(148, 163, 184, 0.42);\n    --ncsg-table-scrollbar-hover: rgba(148, 163, 184, 0.68);\n\n    /* ---------- Code block: dark mode ---------- */\n    --ncsg-code-bg: #282c34;\n    --ncsg-code-gutter-bg: #242932;\n    --ncsg-code-gutter-text: #9aa4b2;\n    --ncsg-code-gutter-border: rgba(255, 255, 255, 0.12);\n}\n\n\n/* ---------- Fallback: system dark mode ---------- */\n@media (prefers-color-scheme: dark) {\n    :root:not([data-user-color-scheme=\"light\"]) {\n        --ncsg-table-text: #c9d1d9;\n        --ncsg-table-bg: #222832;\n        --ncsg-table-head-bg: #2d3542;\n        --ncsg-table-stripe-bg: #262e39;\n        --ncsg-table-hover-bg: #323c4a;\n        --ncsg-table-border: rgba(148, 163, 184, 0.35);\n        --ncsg-table-scrollbar: rgba(148, 163, 184, 0.42);\n        --ncsg-table-scrollbar-hover: rgba(148, 163, 184, 0.68);\n\n        --ncsg-code-bg: #282c34;\n        --ncsg-code-gutter-bg: #242932;\n        --ncsg-code-gutter-text: #9aa4b2;\n        --ncsg-code-gutter-border: rgba(255, 255, 255, 0.12);\n    }\n}\n\n\n/* =========================================================\n * 1. Markdown table horizontal scroll\n *\n * Important:\n * Exclude Hexo highlight tables:\n *   figure.highlight table\n *\n * The previous bug was caused by broad selectors like:\n *   #board table\n * They also matched code-block internal tables.\n * ========================================================= */\n\n:where(.markdown-body, .post-content, .article-content, #board)\ntable:not(.highlight):not(figure.highlight table):not(.highlight table) {\n    display: block !important;\n\n    width: max-content !important;\n    max-width: 100% !important;\n\n    overflow-x: auto !important;\n    overflow-y: hidden !important;\n\n    margin: 1rem 0 !important;\n\n    border-collapse: collapse !important;\n    border-spacing: 0 !important;\n\n    color: var(--ncsg-table-text) !important;\n    background-color: var(--ncsg-table-bg) !important;\n\n    -webkit-overflow-scrolling: touch;\n}\n\n\n/* =========================================================\n * 2. Markdown table cell style\n * ========================================================= */\n\n:where(.markdown-body, .post-content, .article-content, #board)\ntable:not(.highlight):not(figure.highlight table):not(.highlight table)\n:is(th, td) {\n    padding: 0.45rem 0.75rem !important;\n\n    border: 1px solid var(--ncsg-table-border) !important;\n\n    line-height: 1.6 !important;\n    vertical-align: middle !important;\n\n    white-space: nowrap !important;\n\n    color: var(--ncsg-table-text) !important;\n    background-color: var(--ncsg-table-bg) !important;\n}\n\n\n/* =========================================================\n * 3. Markdown table header style\n * ========================================================= */\n\n:where(.markdown-body, .post-content, .article-content, #board)\ntable:not(.highlight):not(figure.highlight table):not(.highlight table)\nth {\n    font-weight: 700 !important;\n    text-align: center !important;\n\n    color: var(--ncsg-table-text) !important;\n    background-color: var(--ncsg-table-head-bg) !important;\n}\n\n\n/* =========================================================\n * 4. Markdown table body style\n * ========================================================= */\n\n:where(.markdown-body, .post-content, .article-content, #board)\ntable:not(.highlight):not(figure.highlight table):not(.highlight table)\ntd {\n    color: var(--ncsg-table-text) !important;\n    background-color: var(--ncsg-table-bg) !important;\n}\n\n\n/* =========================================================\n * 5. Markdown table zebra stripe\n * ========================================================= */\n\n:where(.markdown-body, .post-content, .article-content, #board)\ntable:not(.highlight):not(figure.highlight table):not(.highlight table)\ntbody tr:nth-child(even) td {\n    background-color: var(--ncsg-table-stripe-bg) !important;\n}\n\n\n/* =========================================================\n * 6. Markdown table hover effect\n * ========================================================= */\n\n:where(.markdown-body, .post-content, .article-content, #board)\ntable:not(.highlight):not(figure.highlight table):not(.highlight table)\ntbody tr:hover td {\n    background-color: var(--ncsg-table-hover-bg) !important;\n}\n\n\n/* =========================================================\n * 7. Markdown table scrollbar style\n * ========================================================= */\n\n:where(.markdown-body, .post-content, .article-content, #board)\ntable:not(.highlight):not(figure.highlight table):not(.highlight table)::-webkit-scrollbar {\n    height: 8px;\n}\n\n:where(.markdown-body, .post-content, .article-content, #board)\ntable:not(.highlight):not(figure.highlight table):not(.highlight table)::-webkit-scrollbar-track {\n    background: transparent;\n}\n\n:where(.markdown-body, .post-content, .article-content, #board)\ntable:not(.highlight):not(figure.highlight table):not(.highlight table)::-webkit-scrollbar-thumb {\n    background-color: var(--ncsg-table-scrollbar);\n    border-radius: 999px;\n}\n\n:where(.markdown-body, .post-content, .article-content, #board)\ntable:not(.highlight):not(figure.highlight table):not(.highlight table)::-webkit-scrollbar-thumb:hover {\n    background-color: var(--ncsg-table-scrollbar-hover);\n}\n\n\n/* =========================================================\n * 8. Code block scroll + line number gutter + toolbar\n * ========================================================= */\n\n/*\n * 说明：\n * 1. figure.highlight 本身不再承担滚动。\n * 2. JS 会把代码表格包进 .ncsg-code-scroll。\n * 3. .ncsg-code-scroll 负责横向 / 纵向滚动。\n * 4. 展开后取消 max-height，从而显示完整代码。\n */\n\nfigure.highlight {\n    --ncsg-code-font-family: \"JetBrains Mono\",\n    \"Fira Code\",\n    \"Cascadia Code\",\n    \"SFMono-Regular\",\n    Consolas,\n    \"Liberation Mono\",\n    Menlo,\n    Monaco,\n    monospace;\n\n    --ncsg-code-font-size: 0.92rem;\n    --ncsg-code-line-height: 1.65;\n    --ncsg-code-padding-y: 0.85rem;\n\n    /*\n     * 折叠状态下代码块最大高度。\n     * 可以按喜好改成 420px、520px、60vh 等。\n     */\n    --ncsg-code-collapsed-max-height: 520px;\n\n    margin: 1rem 0 !important;\n    padding: 0 !important;\n\n    background: var(--ncsg-code-bg) !important;\n    border-radius: 6px;\n\n    /*\n     * 重要：\n     * figure 本身不滚动，避免 toolbar 和代码一起滚动导致布局混乱。\n     */\n    overflow: hidden !important;\n\n    position: relative;\n}\n\n/* 工具栏 */\nfigure.highlight .ncsg-code-toolbar {\n  display: flex !important;\n  justify-content: space-between !important;\n  align-items: center !important;\n  gap: 0.75rem !important;\n\n  padding: 0.45rem 0.55rem !important;\n\n  background: var(--ncsg-code-bg) !important;\n  border-bottom: 1px solid var(--ncsg-code-gutter-border) !important;\n\n  user-select: none !important;\n}\n\n/* 左侧语言标签 */\nfigure.highlight .ncsg-code-lang {\n  display: inline-flex;\n  align-items: center;\n\n  min-width: 0;\n\n  padding-left: 0.25rem;\n\n  font-family:\n    \"JetBrains Mono\",\n    \"Fira Code\",\n    \"Cascadia Code\",\n    \"SFMono-Regular\",\n    Consolas,\n    \"Liberation Mono\",\n    Menlo,\n    Monaco,\n    monospace;\n\n  font-size: 0.78rem;\n  line-height: 1;\n\n  color: var(--ncsg-code-gutter-text);\n\n  opacity: 0.85;\n  white-space: nowrap;\n}\n\n/* 没识别到语言时隐藏 */\nfigure.highlight .ncsg-code-lang:empty {\n  display: none;\n}\n\n/* 右侧按钮容器 */\nfigure.highlight .ncsg-code-actions {\n  display: inline-flex;\n  align-items: center;\n  justify-content: flex-end;\n  gap: 0.45rem;\n\n  margin-left: auto;\n}\n\n/* 工具栏按钮 */\nfigure.highlight .ncsg-code-btn {\n  appearance: none;\n\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n\n  width: 1.75rem;\n  height: 1.75rem;\n\n  padding: 0;\n\n  border: 1px solid var(--ncsg-code-gutter-border);\n  border-radius: 4px;\n\n  cursor: pointer;\n\n  color: var(--ncsg-code-gutter-text);\n  background: transparent;\n\n  transition:\n    background-color 0.15s ease,\n    color 0.15s ease,\n    border-color 0.15s ease,\n    opacity 0.15s ease;\n}\n\nfigure.highlight .ncsg-code-btn:hover {\n  color: inherit;\n  background: rgba(127, 127, 127, 0.12);\n}\n\nfigure.highlight .ncsg-code-btn svg {\n  width: 1rem;\n  height: 1rem;\n\n  display: block;\n\n  stroke: currentColor;\n  fill: none;\n  stroke-width: 2;\n  stroke-linecap: round;\n  stroke-linejoin: round;\n\n  pointer-events: none;\n}\n\n/* 不需要展开时隐藏展开按钮 */\nfigure.highlight .ncsg-code-toggle.ncsg-code-toggle-hidden {\n  display: none !important;\n}\n\n/* 复制成功/失败时的轻微状态提示 */\nfigure.highlight .ncsg-code-btn.ncsg-code-copied {\n  color: #22c55e;\n  border-color: rgba(34, 197, 94, 0.55);\n}\n\nfigure.highlight .ncsg-code-btn.ncsg-code-failed {\n  color: #ef4444;\n  border-color: rgba(239, 68, 68, 0.55);\n}\n\n/*\n * JS 创建的滚动容器。\n * 折叠状态：\n * - 横向滚动：保留\n * - 纵向滚动：超过最大高度才出现\n */\nfigure.highlight .ncsg-code-scroll {\n    max-height: var(--ncsg-code-collapsed-max-height);\n\n    overflow-x: auto !important;\n    overflow-y: auto !important;\n\n    background: var(--ncsg-code-bg) !important;\n\n    -webkit-overflow-scrolling: touch;\n}\n\n/*\n * 展开状态：\n * - 不限制高度\n * - 不再纵向滚动\n * - 横向滚动仍然保留\n */\nfigure.highlight.ncsg-code-expanded .ncsg-code-scroll {\n    max-height: none !important;\n\n    overflow-x: auto !important;\n    overflow-y: visible !important;\n}\n\n/*\n * 如果 JS 还没执行，figure.highlight 下面可能直接是 table。\n * 这个 fallback 保证没有 JS 时仍然能横向滚动。\n */\nfigure.highlight:not(.ncsg-code-enhanced) {\n    overflow-x: auto !important;\n    overflow-y: auto !important;\n    max-height: var(--ncsg-code-collapsed-max-height);\n}\n\n/* Reset internal highlight table */\nfigure.highlight table {\n    display: table !important;\n\n    width: max-content !important;\n    min-width: 100% !important;\n    max-width: none !important;\n\n    margin: 0 !important;\n    padding: 0 !important;\n\n    border-collapse: collapse !important;\n    border-spacing: 0 !important;\n    table-layout: auto !important;\n\n    overflow: visible !important;\n\n    color: inherit !important;\n    background: var(--ncsg-code-bg) !important;\n}\n\n/* 防止 Markdown 表格样式污染代码块内部表格 */\nfigure.highlight table,\nfigure.highlight thead,\nfigure.highlight tbody,\nfigure.highlight tr,\nfigure.highlight th,\nfigure.highlight td {\n    margin: 0 !important;\n    border: 0 !important;\n    background-color: transparent !important;\n}\n\n/*\n * 所有代码块单元格。\n * 注意：td 本身不要放上下 padding。\n * 上下 padding 统一放到 gutter pre 和 code pre 上。\n */\nfigure.highlight td {\n    padding: 0 !important;\n    vertical-align: top !important;\n\n    font-family: var(--ncsg-code-font-family) !important;\n    font-size: var(--ncsg-code-font-size) !important;\n    line-height: var(--ncsg-code-line-height) !important;\n}\n\n/* 行号区域 */\nfigure.highlight td.gutter {\n    position: sticky;\n    left: 0;\n    z-index: 3;\n\n    width: 3.5em;\n    min-width: 3.5em;\n    max-width: 3.5em;\n\n    user-select: none;\n    text-align: right;\n\n    color: var(--ncsg-code-gutter-text) !important;\n    background: var(--ncsg-code-gutter-bg) !important;\n    border-right: 1px solid var(--ncsg-code-gutter-border) !important;\n}\n\n/* 代码区域 */\nfigure.highlight td.code {\n    color: inherit !important;\n    background: var(--ncsg-code-bg) !important;\n}\n\n/*\n * 最关键的对齐规则：\n * gutter pre 和 code pre 的这些属性必须完全一致：\n * margin\n * padding-top\n * padding-bottom\n * font-family\n * font-size\n * line-height\n */\nfigure.highlight td.gutter pre,\nfigure.highlight td.code pre {\n    margin: 0 !important;\n\n    padding-top: var(--ncsg-code-padding-y) !important;\n    padding-bottom: var(--ncsg-code-padding-y) !important;\n\n    font-family: var(--ncsg-code-font-family) !important;\n    font-size: var(--ncsg-code-font-size) !important;\n    line-height: var(--ncsg-code-line-height) !important;\n\n    white-space: pre !important;\n    overflow: visible !important;\n\n    background: transparent !important;\n}\n\n/* 行号区只设置左右 padding */\nfigure.highlight td.gutter pre {\n    padding-left: 0.8rem !important;\n    padding-right: 0.75rem !important;\n\n    color: var(--ncsg-code-gutter-text) !important;\n    text-align: right !important;\n}\n\n/* 代码区只设置左右 padding */\nfigure.highlight td.code pre {\n    padding-left: 0.9rem !important;\n    padding-right: 1rem !important;\n\n    color: inherit !important;\n}\n\n/*\n * 重点修复：\n * 很多主题或 highlight.js 会给 pre code / .hljs 加 padding。\n * 这正是“代码内容整体下移半行”的常见原因。\n */\nfigure.highlight td.code pre code,\nfigure.highlight td.code pre .hljs,\nfigure.highlight td.code pre > code,\nfigure.highlight td.code pre > .hljs {\n    display: inline !important;\n\n    margin: 0 !important;\n    padding: 0 !important;\n\n    border: 0 !important;\n\n    font-family: inherit !important;\n    font-size: inherit !important;\n    line-height: inherit !important;\n\n    vertical-align: baseline !important;\n\n    background: transparent !important;\n}\n\n/*\n * 不强制 .line display:block。\n *\n * Hexo 默认 highlight 输出通常是：\n *\n * <span class=\"line\">...</span><br>\n *\n * 如果再强制 .line { display:block; }，会导致每行后面额外叠加 br，\n * 从而行距翻倍或明显错位。\n */\nfigure.highlight .line {\n    display: inline !important;\n\n    margin: 0 !important;\n    padding: 0 !important;\n\n    font-family: inherit !important;\n    font-size: inherit !important;\n    line-height: inherit !important;\n\n    vertical-align: baseline !important;\n\n    background: transparent !important;\n}\n\n/* token span 也统一继承，避免某些 token 改变 line-height */\nfigure.highlight span,\nfigure.highlight code,\nfigure.highlight pre code {\n    font-family: inherit !important;\n    font-size: inherit !important;\n    line-height: inherit !important;\n\n    background: transparent !important;\n}\n\n/* 行号颜色 */\nfigure.highlight td.gutter,\nfigure.highlight td.gutter pre,\nfigure.highlight td.gutter .line,\nfigure.highlight td.gutter span {\n    color: var(--ncsg-code-gutter-text) !important;\n}\n\n/*\n * 滚动条：\n * 因为现在滚动发生在 .ncsg-code-scroll 上，所以 scrollbar 放这里。\n */\nfigure.highlight .ncsg-code-scroll::-webkit-scrollbar {\n    width: 8px;\n    height: 8px;\n}\n\nfigure.highlight .ncsg-code-scroll::-webkit-scrollbar-track {\n    background: transparent;\n}\n\nfigure.highlight .ncsg-code-scroll::-webkit-scrollbar-thumb {\n    background-color: var(--ncsg-table-scrollbar);\n    border-radius: 999px;\n}\n\nfigure.highlight .ncsg-code-scroll::-webkit-scrollbar-thumb:hover {\n    background-color: var(--ncsg-table-scrollbar-hover);\n}\n\n/* Firefox scrollbar */\nfigure.highlight .ncsg-code-scroll {\n    scrollbar-width: thin;\n    scrollbar-color: var(--ncsg-table-scrollbar) transparent;\n}\n\n/* 移动端适配 */\n@media (max-width: 768px) {\n    figure.highlight {\n        --ncsg-code-font-size: 0.86rem;\n        --ncsg-code-line-height: 1.6;\n        --ncsg-code-collapsed-max-height: 420px;\n    }\n\n    figure.highlight td.gutter {\n        width: 3em;\n        min-width: 3em;\n        max-width: 3em;\n    }\n\n    figure.highlight .ncsg-code-toolbar {\n        padding: 0.4rem 0.45rem;\n    }\n\n    figure.highlight .ncsg-code-btn {\n        font-size: 0.74rem;\n    }\n}\n\n\n/* =========================================================\n * 9. Mobile optimization\n * ========================================================= */\n\n@media (max-width: 768px) {\n    :where(.markdown-body, .post-content, .article-content, #board)\n    table:not(.highlight):not(figure.highlight table):not(.highlight table) {\n        max-width: 100% !important;\n    }\n\n    :where(.markdown-body, .post-content, .article-content, #board)\n    table:not(.highlight):not(figure.highlight table):not(.highlight table)\n    :is(th, td) {\n        padding: 0.4rem 0.65rem !important;\n        font-size: 0.92rem !important;\n    }\n\n    figure.highlight td.gutter {\n        width: 3em;\n        min-width: 3em;\n        max-width: 3em;\n    }\n}\n\n/* =========================================================\n * 10. MathJax compatibility\n *\n * Prevent visual duplication caused by visible assistive MathML\n * and improve display formula overflow behavior.\n * ========================================================= */\n\n/* Display formulas: allow horizontal scroll when too long */\nmjx-container[display=\"true\"] {\n    display: block;\n    max-width: 100%;\n    overflow-x: auto;\n    overflow-y: hidden;\n    margin: 1em 0;\n    color: inherit;\n}\n\n/* Inline formulas: keep natural inline behavior */\nmjx-container:not([display=\"true\"]) {\n    color: inherit;\n}\n\n/* SVG output fallback, harmless for CHTML output */\nmjx-container svg {\n    max-width: none;\n}\n\n/* If MathJax assistive MathML becomes visible because of CSS reset,\n * force it to be visually hidden again.\n */\nmjx-assistive-mml {\n    position: absolute !important;\n    top: 0;\n    left: 0;\n\n    width: 1px !important;\n    height: 1px !important;\n\n    padding: 0 !important;\n    border: 0 !important;\n    margin: 0 !important;\n\n    overflow: hidden !important;\n    clip: rect(1px, 1px, 1px, 1px) !important;\n    white-space: nowrap !important;\n}"},{"title":"Results","_content":"\n<div class=\"ncsg-project-grid\">\n\n  <a class=\"ncsg-project-card\" href=\"https://zenodo.org/\">\n    <div class=\"ncsg-project-card-header\">\n      <h3>Hawk: Unconstraint GRACE/GRACE-FO Level-2 products</h3>\n      <img src=\"../img/results/pyhawk_global.png\" alt=\"Satellite gravity project\">\n    </div>\n    <div class=\"ncsg-project-card-body\">\n      <p>\n        Here gives some descrition.\n      </p>\n    </div>\n  </a>\n\n  <a class=\"ncsg-project-card\" href=\"https://zenodo.org/\">\n    <div class=\"ncsg-project-card-header\">\n      <h3>Assimilation products of GRACE/GRACE-FO observation and w3ra models</h3>\n      <img src=\"../img/results/data_assimilation.png\" alt=\"Satellite gravity project\">\n    </div>\n    <div class=\"ncsg-project-card-body\">\n      <p>\n        Here gives some descrition.\n      </p>\n    </div>\n  </a>\n\n  <a class=\"ncsg-project-card\" href=\"https://zenodo.org/\">\n    <div class=\"ncsg-project-card-header\">\n      <h3>FSC: An efficient filter for GRACE/GRACE-FO Level-2 products</h3>\n      <img src=\"../img/results/FSC_global.png\" alt=\"Satellite gravity project\">\n    </div>\n    <div class=\"ncsg-project-card-body\">\n      <p>\n        Here gives some descrition.\n      </p>\n    </div>\n  </a>\n\n</div>\n","source":"results/index.md","raw":"---\ntitle: Results\n---\n\n<div class=\"ncsg-project-grid\">\n\n  <a class=\"ncsg-project-card\" href=\"https://zenodo.org/\">\n    <div class=\"ncsg-project-card-header\">\n      <h3>Hawk: Unconstraint GRACE/GRACE-FO Level-2 products</h3>\n      <img src=\"../img/results/pyhawk_global.png\" alt=\"Satellite gravity project\">\n    </div>\n    <div class=\"ncsg-project-card-body\">\n      <p>\n        Here gives some descrition.\n      </p>\n    </div>\n  </a>\n\n  <a class=\"ncsg-project-card\" href=\"https://zenodo.org/\">\n    <div class=\"ncsg-project-card-header\">\n      <h3>Assimilation products of GRACE/GRACE-FO observation and w3ra models</h3>\n      <img src=\"../img/results/data_assimilation.png\" alt=\"Satellite gravity project\">\n    </div>\n    <div class=\"ncsg-project-card-body\">\n      <p>\n        Here gives some descrition.\n      </p>\n    </div>\n  </a>\n\n  <a class=\"ncsg-project-card\" href=\"https://zenodo.org/\">\n    <div class=\"ncsg-project-card-header\">\n      <h3>FSC: An efficient filter for GRACE/GRACE-FO Level-2 products</h3>\n      <img src=\"../img/results/FSC_global.png\" alt=\"Satellite gravity project\">\n    </div>\n    <div class=\"ncsg-project-card-body\">\n      <p>\n        Here gives some descrition.\n      </p>\n    </div>\n  </a>\n\n</div>\n","date":"2026-07-30T02:18:50.970Z","updated":"2026-07-30T02:18:50.970Z","path":"results/index.html","comments":1,"layout":"page","_i