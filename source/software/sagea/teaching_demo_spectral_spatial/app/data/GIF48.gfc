product_type                  gravity_field
modelname                     GIF48
earth_gravity_constant        0.3986004415E+15
radius                        0.6378136300E+07
max_degree                    360
errors                        calibrated
norm                          fully_normalized
tide_system                   zero_tide
 
 
 
